{% extends 'base.html.twig' %}

{% block title %}Détails de l'Employé - {{ employe.prenom }} {{ employe.nom }}{% endblock %}

{% block body %}
<div class="row g-0">
    <div class="col-12">
        <div class="card compact-page">
            <div class="card-header compact-header py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h4 class="mb-0">
                            <i class="fas fa-user me-1"></i>
                            Détails de l'Employé
                        </h4>
                        <small class="text-muted">
                            <strong>{{ employe.prenom }} {{ employe.nom }}</strong> - ID: {{ employe.id }}
                        </small>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="{{ path('responsable_edit_employe', {'id': employe.id}) }}" class="btn btn-primary btn-sm">
                            <i class="fas fa-edit me-1"></i>Modifier
                        </a>
                        <a href="{{ path('responsable_manage_employes') }}" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Retour
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body compact-body p-2">
                <!-- Informations personnelles -->
                <div class="row mb-2 g-2">
                    <div class="col-md-6">
                        <div class="card border-primary mb-0">
                            <div class="card-header bg-primary text-white py-1 px-2">
                                <h6 class="mb-0" style="font-size: 0.9rem;"><i class="fas fa-id-card me-1"></i>Informations Personnelles</h6>
                            </div>
                            <div class="card-body p-2">
                                <div class="row mb-1" style="font-size: 0.85rem;">
                                    <div class="col-sm-4"><strong>Nom :</strong></div>
                                    <div class="col-sm-8">{{ employe.nom }}</div>
                                </div>
                                <hr class="my-1">
                                <div class="row mb-1" style="font-size: 0.85rem;">
                                    <div class="col-sm-4"><strong>Prénom :</strong></div>
                                    <div class="col-sm-8">{{ employe.prenom }}</div>
                                </div>
                                <hr class="my-1">
                                <div class="row mb-1" style="font-size: 0.85rem;">
                                    <div class="col-sm-4"><strong>Email :</strong></div>
                                    <div class="col-sm-8">{{ employe.email }}</div>
                                </div>
                                <hr class="my-1">
                                <div class="row mb-1" style="font-size: 0.85rem;">
                                    <div class="col-sm-4"><strong>Organisation :</strong></div>
                                    <div class="col-sm-8">
                                        {% if employe.employeeContrats is not empty %}
                                            {% set currentContrat = employe.employeeContrats|first %}
                                            {% if currentContrat.organisationEmployeeContrats is not empty %}
                                                {% set currentOrg = currentContrat.organisationEmployeeContrats|first.organisation %}
                                                <small>{{ currentOrg.dossierDesignation }}</small>
                                            {% else %}
                                                <span class="text-muted">Non assigné</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">Non assigné</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <hr class="my-1">
                                <div class="row mb-1" style="font-size: 0.85rem;">
                                    <div class="col-sm-4"><strong>Rôles :</strong></div>
                                    <div class="col-sm-8">
                                        {% for role in employe.roles %}
                                            <span class="badge bg-info me-1" style="font-size: 0.7rem;">{{ role }}</span>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-success mb-0">
                            <div class="card-header bg-success text-white py-1 px-2">
                                <h6 class="mb-0" style="font-size: 0.9rem;"><i class="fas fa-chart-pie me-1"></i>Statistiques</h6>
                            </div>
                            <div class="card-body p-2">
                                <div class="row text-center">
                                    <div class="col-6">
                                        <div class="border-end">
                                            <h5 class="text-primary mb-0" style="font-size: 1.5rem;">{{ employe.employeeContrats|length }}</h5>
                                            <small class="text-muted">Contrat(s)</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <h5 class="text-success mb-0" style="font-size: 1.5rem;">{{ employe.dossier ? 1 : 0 }}</h5>
                                        <small class="text-muted">Dossier(s)</small>
                                    </div>
                                </div>
                                <hr class="my-1">
                                <div class="row text-center">
                                    <div class="col-6">
                                        <div class="border-end">
                                            <h5 class="text-info mb-0" style="font-size: 1.5rem;">{{ employe.demandes|length }}</h5>
                                            <small class="text-muted">Demande(s)</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <h5 class="text-warning mb-0" style="font-size: 1.5rem;">{{ employe.dossier ? 1 : 0 }}</h5>
                                        <small class="text-muted">Dossier(s)</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contrats -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card border-warning mb-0">
                            <div class="card-header bg-warning text-dark py-1 px-2">
                                <h6 class="mb-0" style="font-size: 0.9rem;"><i class="fas fa-file-contract me-1"></i>Historique des Contrats</h6>
                            </div>
                            <div class="card-body p-2">
                                {% if employe.employeeContrats|length > 0 %}
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover mb-0 compact-table-inner">
                                            <thead>
                                                <tr>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Type</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Nature du Contrat</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Organisation</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Date Début</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Date Fin</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Statut</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Durée</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for contrat in employe.employeeContrats %}
                                                <tr>
                                                    <td style="padding: 0.2rem 0.25rem !important;">
                                                        {% if loop.first %}
                                                            <span class="badge bg-primary" style="font-size: 0.7rem;">Principal</span>
                                                        {% else %}
                                                            <span class="badge bg-info" style="font-size: 0.7rem;">Secondaire</span>
                                                        {% endif %}
                                                    </td>
                                                    <td style="padding: 0.2rem 0.25rem !important;">
                                                        <span class="badge bg-primary" style="font-size: 0.7rem;" title="{{ contrat.natureContrat }}">{{ contrat.natureContrat|slice(0, 20) }}{% if contrat.natureContrat|length > 20 %}...{% endif %}</span>
                                                    </td>
                                                    <td style="padding: 0.2rem 0.25rem !important;">
                                                        {% if contrat.organisationEmployeeContrats is not empty %}
                                                            {% for orgContrat in contrat.organisationEmployeeContrats %}
                                                                <span class="badge bg-secondary" style="font-size: 0.7rem;" title="{{ orgContrat.organisation.dossierDesignation }}">{{ orgContrat.organisation.dossierDesignation|slice(0, 15) }}{% if orgContrat.organisation.dossierDesignation|length > 15 %}...{% endif %}</span>
                                                            {% endfor %}
                                                        {% else %}
                                                            <small class="text-muted" style="font-size: 0.8rem;">Non assigné</small>
                                                        {% endif %}
                                                    </td>
                                                    <td style="padding: 0.2rem 0.25rem !important; font-size: 0.8rem;">{{ contrat.dateDebut|date('d/m/Y') }}</td>
                                                    <td style="padding: 0.2rem 0.25rem !important; font-size: 0.8rem;">
                                                        {% if contrat.dateFin %}
                                                            {{ contrat.dateFin|date('d/m/Y') }}
                                                        {% else %}
                                                            <small class="text-muted">Non définie</small>
                                                        {% endif %}
                                                    </td>
                                                    <td style="padding: 0.2rem 0.25rem !important;">
                                                        {% if contrat.statut == 'actif' %}
                                                            <span class="badge bg-success" style="font-size: 0.7rem;">Actif</span>
                                                        {% elseif contrat.statut == 'expire' %}
                                                            <span class="badge bg-danger" style="font-size: 0.7rem;">Expiré</span>
                                                        {% elseif contrat.statut == 'suspendu' %}
                                                            <span class="badge bg-warning" style="font-size: 0.7rem;">Suspendu</span>
                                                        {% else %}
                                                            <span class="badge bg-secondary" style="font-size: 0.7rem;">{{ contrat.statut }}</span>
                                                        {% endif %}
                                                    </td>
                                                    <td style="padding: 0.2rem 0.25rem !important; font-size: 0.8rem;">
                                                        {% if contrat.dateFin %}
                                                            {% set duree = contrat.dateFin.diff(contrat.dateDebut) %}
                                                            {{ duree.y }} an(s), {{ duree.m }} mois
                                                        {% else %}
                                                            <small class="text-muted">En cours</small>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% else %}
                                    <div class="alert alert-info alert-xs py-2 px-3 text-center mb-0">
                                        <small><i class="fas fa-info-circle me-1"></i>Aucun contrat trouvé pour cet employé.</small>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Dossiers récents -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card border-info mb-0">
                            <div class="card-header bg-info text-white py-1 px-2">
                                <h6 class="mb-0" style="font-size: 0.9rem;"><i class="fas fa-folder me-1"></i>Dossier de l'Employé</h6>
                            </div>
                            <div class="card-body p-2">
                                {% if employe.dossier %}
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover mb-0 compact-table-inner">
                                            <thead>
                                                <tr>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">ID</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Titre</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Placard</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Documents</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Date Création</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% set dossier = employe.dossier %}
                                                <tr>
                                                    <td style="padding: 0.2rem 0.25rem !important; font-size: 0.8rem;">{{ dossier.id }}</td>
                                                    <td style="padding: 0.2rem 0.25rem !important; font-size: 0.8rem;">{{ dossier.nom }}</td>
                                                    <td style="padding: 0.2rem 0.25rem !important;">
                                                        {% if dossier.placard %}
                                                            <span class="badge bg-secondary" style="font-size: 0.7rem;">{{ dossier.placard.name }}</span>
                                                        {% else %}
                                                            <small class="text-muted" style="font-size: 0.8rem;">Aucun</small>
                                                        {% endif %}
                                                    </td>
                                                    <td style="padding: 0.2rem 0.25rem !important;">
                                                        <span class="badge bg-primary" style="font-size: 0.7rem;">Dossier</span>
                                                    </td>
                                                    <td style="padding: 0.2rem 0.25rem !important; font-size: 0.8rem;">{{ dossier.createdAt|date('d/m/Y H:i') }}</td>
                                                    <td style="padding: 0.2rem 0.25rem !important;">
                                                        <a href="{{ path('responsable_view_dossier_documents', {'id': dossier.id}) }}" class="btn btn-xs btn-info py-0 px-1" title="Voir les documents" style="font-size: 0.7rem;">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                {% else %}
                                    <div class="alert alert-info alert-xs py-2 px-3 text-center mb-0">
                                        <small><i class="fas fa-info-circle me-1"></i>Aucun dossier trouvé pour cet employé.</small>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Demandes récentes -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card border-secondary mb-0">
                            <div class="card-header bg-secondary text-white py-1 px-2">
                                <h6 class="mb-0" style="font-size: 0.9rem;"><i class="fas fa-envelope me-1"></i>Demandes Récentes</h6>
                            </div>
                            <div class="card-body p-2">
                                {% if employe.demandes|length > 0 %}
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover mb-0 compact-table-inner">
                                            <thead>
                                                <tr>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">ID</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Sujet</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Statut</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Date Création</th>
                                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for demande in employe.demandes|slice(0, 5) %}
                                                <tr>
                                                    <td style="padding: 0.2rem 0.25rem !important; font-size: 0.8rem;">{{ demande.id }}</td>
                                                    <td style="padding: 0.2rem 0.25rem !important; font-size: 0.8rem;" title="{{ demande.titre }}">{{ demande.titre|slice(0, 30) }}{% if demande.titre|length > 30 %}...{% endif %}</td>
                                                    <td style="padding: 0.2rem 0.25rem !important;">
                                                        {% if demande.statut == 'en_attente' %}
                                                            <span class="badge bg-warning" style="font-size: 0.7rem;">En attente</span>
                                                        {% elseif demande.statut == 'acceptee' %}
                                                            <span class="badge bg-success" style="font-size: 0.7rem;">Acceptée</span>
                                                        {% elseif demande.statut == 'refusee' %}
                                                            <span class="badge bg-danger" style="font-size: 0.7rem;">Refusée</span>
                                                        {% else %}
                                                            <span class="badge bg-info" style="font-size: 0.7rem;">{{ demande.statut }}</span>
                                                        {% endif %}
                                                    </td>
                                                    <td style="padding: 0.2rem 0.25rem !important; font-size: 0.8rem;">{{ demande.dateCreation|date('d/m/Y H:i') }}</td>
                                                    <td style="padding: 0.2rem 0.25rem !important;">
                                                        <a href="{{ path('responsable_voir_demande', {'id': demande.id}) }}" class="btn btn-xs btn-info py-0 px-1" title="Voir la demande" style="font-size: 0.7rem;">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                    {% if employe.demandes|length > 5 %}
                                        <div class="text-center mt-1">
                                            <small class="text-muted" style="font-size: 0.75rem;">Affichage des 5 demandes les plus récentes sur {{ employe.demandes|length }} au total</small>
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <div class="alert alert-info alert-xs py-2 px-3 text-center mb-0">
                                        <small><i class="fas fa-info-circle me-1"></i>Aucune demande trouvée pour cet employé.</small>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .compact-page {
        margin-bottom: 0;
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    
    .compact-header {
        padding: 0.4rem 0.75rem !important;
        background-color: #ffffff;
        border-bottom: 1px solid #bcccdc;
        flex-shrink: 0;
    }
    
    .compact-header h4 {
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
    }
    
    .compact-body {
        padding: 0.4rem !important;
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
    }
    
    .compact-table-inner {
        margin-bottom: 0;
        font-size: 0.875rem;
    }
    
    .compact-table-inner th,
    .compact-table-inner td {
        font-size: 0.8rem;
        vertical-align: middle;
        padding: 0.2rem 0.25rem !important;
        line-height: 1.3;
    }
    
    .compact-table-inner thead th {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        background-color: #ffffff;
    }
    
    .compact-table-inner tbody tr {
        background-color: #ffffff !important;
    }
    
    .compact-table-inner tbody tr:hover {
        background-color: #d9eafd !important;
    }
    
    .alert-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        margin-bottom: 0.5rem;
    }
    
    .btn-xs {
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 0.2rem;
    }
    
    .badge {
        font-size: 0.7rem;
        padding: 0.2rem 0.4rem;
    }
    
    .card .card-header {
        padding: 0.5rem 0.75rem;
    }
    
    .card .card-body {
        padding: 0.75rem;
    }
    
    @media (max-width: 767px) {
        .compact-header {
            padding: 0.3rem 0.5rem !important;
        }
        
        .compact-header .d-flex {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 0.5rem;
        }
        
        .compact-body {
            padding: 0.3rem !important;
        }
        
        .table-responsive {
            overflow-x: auto;
        }
    }
</style>
{% endblock %}
