{% extends 'base.html.twig' %}

{% block title %}Gestion des Placards{% endblock %}

{% block body %}
<div class="row g-0">
    <div class="col-12">
        <div class="card compact-page">
            <div class="card-header compact-header py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="mb-0">
                            <i class="fas fa-archive me-1"></i>Gestion des Placards
                        </h4>
                        <div class="d-flex align-items-center gap-2">
                            <div class="d-flex align-items-center gap-1 text-primary">
                                <i class="fas fa-archive small"></i>
                                <span class="fw-bold small">{{ totalPlacards }}</span>
                                <small class="text-muted" style="font-size: 0.75rem;">Total</small>
                            </div>
                            <div class="d-flex align-items-center gap-1 text-success">
                                <i class="fas fa-check-circle small"></i>
                                <span class="fw-bold small">{{ activePlacards }}</span>
                                <small class="text-muted" style="font-size: 0.75rem;">Actifs</small>
                            </div>
                            <div class="d-flex align-items-center gap-1 text-secondary">
                                <i class="fas fa-times-circle small"></i>
                                <span class="fw-bold small">{{ inactivePlacards }}</span>
                                <small class="text-muted" style="font-size: 0.75rem;">Inactifs</small>
                            </div>
                        </div>
                    </div>
                    <a href="{{ path('responsable_add_placard') }}" class="btn btn-success btn-xs">
                        <i class="fas fa-plus"></i> Ajouter
                    </a>
                </div>
                <div class="mt-2 d-flex align-items-center gap-2 flex-wrap">
                    <label for="statusFilter" class="mb-0 small text-muted" style="font-size: 0.75rem;">
                        <i class="fas fa-filter"></i> Filtrer :
                    </label>
                    <select id="statusFilter" class="form-select form-select-sm" style="width: auto; font-size: 0.75rem; padding: 0.125rem 1.5rem 0.125rem 0.5rem;" onchange="changeStatusFilter(this.value)">
                        <option value="all" {{ status == 'all' ? 'selected' : '' }}>Tous</option>
                        <option value="active" {{ status == 'active' ? 'selected' : '' }}>Actifs uniquement</option>
                        <option value="inactive" {{ status == 'inactive' ? 'selected' : '' }}>Inactifs uniquement</option>
                    </select>
                </div>
            </div>
            <div class="card-body compact-body p-2">
                {% if status and status != 'all' %}
                    <div class="alert alert-info alert-xs py-1 px-2 mb-2 d-flex align-items-center justify-content-between">
                        <small class="mb-0">
                            <i class="fas fa-filter me-1"></i>
                            Filtré par :
                            {% if status == 'active' %}
                                <strong>Actifs uniquement</strong>
                            {% elseif status == 'inactive' %}
                                <strong>Inactifs uniquement</strong>
                            {% endif %}
                            ({{ placards|length }} résultat{% if placards|length != 1 %}s{% endif %})
                        </small>
                        <a href="{{ path('responsable_manage_placards') }}" class="btn btn-xs btn-outline-primary py-0" title="Effacer le filtre">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>
                {% endif %}
                
                {% if placards is empty %}
                    <div class="alert alert-info alert-xs py-2 px-3 text-center mb-0">
                        <small><i class="fas fa-info-circle me-1"></i>Aucun placard trouvé.</small>
                    </div>
                {% else %}
                    <div class="table-responsive compact-table">
                        <table class="table table-sm table-hover table-striped mb-0 compact-table-inner">
                            <thead class="table-light">
                                <tr>
                                    <th style="padding: 0.25rem;">ID</th>
                                    <th style="padding: 0.25rem;">Nom</th>
                                    <th style="padding: 0.25rem;">Localisation</th>
                                    <th style="padding: 0.25rem;">Dossiers</th>
                                    <th style="padding: 0.25rem;">Statut</th>
                                    <th style="padding: 0.25rem;">Date</th>
                                    <th style="padding: 0.25rem;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for placard in placards %}
                                <tr class="{{ not placard.isActive ? 'table-secondary' : '' }}">
                                    <td style="padding: 0.25rem;">{{ placard.id }}</td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;"><strong>{{ placard.name }}</strong></td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">
                                        <i class="fas fa-map-marker-alt me-1" style="font-size: 0.7rem;"></i>{{ placard.location|slice(0, 25) }}{% if placard.location|length > 25 %}...{% endif %}
                                    </td>
                                    <td style="padding: 0.25rem;">
                                        <span class="badge bg-primary" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">{{ placard.dossiers|length }}</span>
                                    </td>
                                    <td style="padding: 0.25rem;">
                                        {% if placard.isActive %}
                                            <span class="badge bg-success" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">
                                                <i class="fas fa-check-circle me-1"></i>Actif
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">
                                                <i class="fas fa-times-circle me-1"></i>Inactif
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ placard.createdAt|date('d/m/Y') }}</td>
                                    <td style="padding: 0.25rem;">
                                        <div class="btn-group btn-group-xs" role="group">
                                            <a href="{{ path('responsable_view_placard', {'id': placard.id}) }}" 
                                               class="btn btn-outline-info btn-xs py-0 px-1" 
                                               title="Voir">
                                                <i class="fas fa-eye" style="font-size: 0.7rem;"></i>
                                            </a>
                                            <a href="{{ path('responsable_edit_placard', {'id': placard.id}) }}" 
                                               class="btn btn-outline-warning btn-xs py-0 px-1" 
                                               title="Modifier">
                                                <i class="fas fa-edit" style="font-size: 0.7rem;"></i>
                                            </a>
                                            <a href="{{ path('responsable_toggle_placard_actif', {'id': placard.id}) }}" 
                                               class="btn btn-xs py-0 px-1 {{ placard.isActive ? 'btn-outline-danger' : 'btn-outline-success' }}" 
                                               title="{{ placard.isActive ? 'Désactiver' : 'Activer' }}"
                                               onclick="return confirm('Êtes-vous sûr de vouloir {{ placard.isActive ? 'désactiver' : 'activer' }} ce placard ?');">
                                                <i class="fas {{ placard.isActive ? 'fa-toggle-on' : 'fa-toggle-off' }}" style="font-size: 0.7rem;"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
            
            <div class="card-footer compact-footer py-1 px-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <label for="perPageSelect" class="mb-0 small text-muted" style="font-size: 0.75rem;">
                            <i class="fas fa-list-ul"></i> Par page:
                        </label>
                        <select id="perPageSelect" class="form-select form-select-sm" style="width: auto; font-size: 0.75rem; padding: 0.125rem 1.5rem 0.125rem 0.5rem;" onchange="changePerPage(this.value)">
                            <option value="10" {{ (perPage ?? 10) == 10 ? 'selected' : '' }}>10</option>
                            <option value="20" {{ (perPage ?? 10) == 20 ? 'selected' : '' }}>20</option>
                            <option value="30" {{ (perPage ?? 10) == 30 ? 'selected' : '' }}>30</option>
                            <option value="50" {{ (perPage ?? 10) == 50 ? 'selected' : '' }}>50</option>
                            <option value="100" {{ (perPage ?? 10) == 100 ? 'selected' : '' }}>100</option>
                        </select>
                    </div>
                    {% if placards.pageCount > 1 %}
                        <div>
                            {{ knp_pagination_render(placards, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .app-wrapper {
        height: 100vh;
        overflow: hidden;
    }
    
    .main-content {
        overflow: hidden !important;
        height: 100vh;
    }
    
    .navbar-area {
        flex-shrink: 0;
    }
    
    .main-area {
        padding: 0 !important;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    
    .container-fluid {
        padding: 0.5rem 0.75rem !important;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    
    .row.g-0 {
        margin: 0;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    
    .row.g-0 > .col-12 {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        padding: 0;
    }
    
    .compact-page {
        margin-bottom: 0;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    
    .card {
        margin-bottom: 0;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    
    .compact-header {
        padding: 0.4rem 0.75rem !important;
        background-color: #f8fafc;
        border-bottom: 1px solid #bcccdc;
        flex-shrink: 0;
    }
    
    .compact-header h4 {
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
    }
    
    .compact-body {
        padding: 0.4rem !important;
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
    }
    
    .compact-table {
        margin: 0;
        overflow-x: visible;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    
    .compact-table table {
        flex: 1;
    }
    
    @media (max-width: 767px) {
        .container-fluid {
            padding: 0.4rem 0.5rem !important;
        }
        
        .compact-header {
            padding: 0.3rem 0.5rem !important;
        }
        
        .compact-body {
            padding: 0.3rem !important;
        }
        
        .compact-table {
            overflow-x: auto;
        }
    }
    
    .compact-table-inner {
        margin-bottom: 0;
        font-size: 0.875rem;
    }
    
    .compact-table-inner th,
    .compact-table-inner td {
        font-size: 0.8rem;
        vertical-align: middle;
        padding: 0.2rem 0.25rem !important;
        line-height: 1.3;
    }
    
    .compact-table-inner thead th {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        background-color: #f8fafc;
    }
    
    .compact-table-inner tbody tr {
        background-color: #ffffff;
    }
    
    .compact-table-inner tbody tr:hover {
        background-color: #d9eafd !important;
    }
    
    .btn-xs {
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 0.2rem;
    }
    
    .btn-group-xs .btn {
        padding: 0.1rem 0.3rem;
        font-size: 0.7rem;
    }
    
    .alert-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        margin-bottom: 0.5rem;
    }
    
    .compact-footer {
        padding: 0.2rem 0.5rem !important;
        background-color: #f8fafc;
        border-top: 1px solid #bcccdc;
        flex-shrink: 0;
    }
    
    .compact-footer .pagination {
        margin-bottom: 0;
    }
    
    .compact-footer .pagination .page-link {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }
    
    .pagination {
        font-size: 0.75rem;
    }
    
    .pagination .page-link {
        padding: 0.2rem 0.4rem;
    }
</style>

<script>
function changePerPage(value) {
    const url = new URL(window.location.href);
    url.searchParams.set('perPage', value);
    url.searchParams.set('page', '1'); // Reset to first page when changing perPage
    window.location.href = url.toString();
}

function changeStatusFilter(value) {
    const url = new URL(window.location.href);
    url.searchParams.set('status', value);
    url.searchParams.set('page', '1'); // Reset to first page when changing filter
    window.location.href = url.toString();
}
</script>
{% endblock %}
