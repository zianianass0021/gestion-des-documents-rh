{% extends 'base.html.twig' %}

{% block title %}Dossiers du Placard - {{ placard.name }}{% endblock %}

{% block body %}
<style>
    body {
        overflow: hidden !important;
        height: 100vh;
        margin: 0;
        padding: 0;
    }
    
    .app-wrapper {
        height: 100vh;
        overflow: hidden;
    }
    
    .main-content {
        overflow: hidden !important;
        height: 100vh;
        display: flex;
        flex-direction: column;
    }
    
    .navbar-area {
        flex-shrink: 0;
    }
    
    .main-area {
        padding: 0.5rem 0.75rem !important;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        height: 100%;
    }
    
    .container-fluid {
        padding: 0 !important;
        height: 100%;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
</style>
<div class="container-fluid">
    <!-- En-tête simple -->
    <div class="row mb-0" style="flex-shrink: 0; margin-bottom: 0.4rem !important;">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0" style="font-size: 1.05rem; line-height: 1.25; font-weight: 600;">
                        <i class="fas fa-folder me-1" style="font-size: 0.95rem;"></i>
                        {{ placard.name }}
                    </h2>
                    <p class="text-muted mb-0" style="font-size: 0.8rem; line-height: 1.25;">
                        <i class="fas fa-map-marker-alt me-1"></i>{{ placard.location }} • 
                        Créé le {{ placard.createdAt|date('d/m/Y') }}
                    </p>
                </div>
                <a href="{{ path('responsable_manage_placards') }}" class="btn btn-outline-secondary btn-sm" style="font-size: 0.8rem; padding: 0.3rem 0.5rem; line-height: 1.25;">
                    <i class="fas fa-arrow-left me-1"></i>Retour
                </a>
            </div>
        </div>
    </div>

    {% if dossiers.items is not empty %}
    <!-- Barre de recherche simple -->
    <div class="row mb-0" style="flex-shrink: 0; margin-bottom: 0.4rem !important;">
        <div class="col-md-6">
            <div class="input-group input-group-sm">
                <span class="input-group-text" style="padding: 0.3rem 0.4rem; font-size: 0.8rem;">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text" class="form-control form-control-sm" id="searchInput" placeholder="Rechercher..." style="font-size: 0.8rem; padding: 0.3rem 0.4rem; line-height: 1.3;">
                <button class="btn btn-outline-secondary btn-sm" type="button" id="clearSearch" style="font-size: 0.8rem; padding: 0.3rem 0.4rem;">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
        <div class="col-md-6 text-end">
            <span class="badge bg-secondary" style="font-size: 0.75rem; padding: 0.3rem 0.45rem; line-height: 1.25;">
                {{ dossiers.totalItemCount }} dossier{{ dossiers.totalItemCount > 1 ? 's' : '' }}
            </span>
        </div>
    </div>

    <!-- Liste des dossiers en tableau -->
    <div class="card mb-0" style="flex: 1; min-height: 0; display: flex; flex-direction: column; margin-bottom: 0; border: 1px solid #BCCCDC;">
        <div class="card-body p-0" style="flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden; padding: 0 !important;">
            <div class="table-responsive" style="flex: 1; min-height: 0; overflow: visible;">
                <table class="table table-sm table-hover mb-0 compact-table" style="margin-bottom: 0;">
                    <thead class="table-light" style="position: sticky; top: 0; z-index: 10; background-color: #F8FAFC;">
                        <tr>
                            <th style="padding: 0.4rem 0.35rem !important; font-size: 0.75rem; font-weight: 600; line-height: 1.3;">Nom du Dossier</th>
                            <th style="padding: 0.4rem 0.35rem !important; font-size: 0.75rem; font-weight: 600; line-height: 1.3;">Employé</th>
                            <th style="padding: 0.4rem 0.35rem !important; font-size: 0.75rem; font-weight: 600; line-height: 1.3;">Emplacement</th>
                            <th style="padding: 0.4rem 0.35rem !important; font-size: 0.75rem; font-weight: 600; line-height: 1.3;">Statut</th>
                            <th style="padding: 0.4rem 0.35rem !important; font-size: 0.75rem; font-weight: 600; line-height: 1.3;">Documents</th>
                            <th style="padding: 0.4rem 0.35rem !important; font-size: 0.75rem; font-weight: 600; line-height: 1.3;">Créé le</th>
                            <th class="text-center" style="padding: 0.4rem 0.35rem !important; font-size: 0.75rem; font-weight: 600; line-height: 1.3;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="dossiersContainer">
                        {% for dossier in dossiers.items %}
                        <tr class="dossier-row">
                            <td style="padding: 0.4rem 0.35rem !important; font-size: 0.8rem; line-height: 1.4;">
                                <i class="fas fa-folder me-2 text-primary" style="font-size: 0.85rem;"></i>
                                <strong>{{ dossier.nom }}</strong>
                            </td>
                            <td style="padding: 0.4rem 0.35rem !important; font-size: 0.8rem; line-height: 1.4;">
                                <i class="fas fa-user me-2 text-muted" style="font-size: 0.85rem;"></i>
                                {{ dossier.employe.prenom }} {{ dossier.employe.nom }}
                            </td>
                            <td style="padding: 0.4rem 0.35rem !important; font-size: 0.8rem; line-height: 1.4;">
                                {% if dossier.emplacement %}
                                    <i class="fas fa-map-marker-alt me-2 text-muted" style="font-size: 0.85rem;"></i>
                                    <strong>{{ dossier.emplacement }}</strong>
                                {% else %}
                                    <span class="text-muted">Non défini</span>
                                {% endif %}
                            </td>
                            <td style="padding: 0.4rem 0.35rem !important; font-size: 0.8rem; line-height: 1.4;">
                                {% if dossier.status == 'completed' %}
                                    <span class="badge bg-success" style="font-size: 0.7rem; padding: 0.25rem 0.4rem; line-height: 1.25;">Complet</span>
                                {% elseif dossier.status == 'in_progress' %}
                                    <span class="badge bg-warning" style="font-size: 0.7rem; padding: 0.25rem 0.4rem; line-height: 1.25;">En cours</span>
                                {% else %}
                                    <span class="badge bg-secondary" style="font-size: 0.7rem; padding: 0.25rem 0.4rem; line-height: 1.25;">En attente</span>
                                {% endif %}
                            </td>
                            <td style="padding: 0.4rem 0.35rem !important; font-size: 0.8rem; line-height: 1.4;">
                                <i class="fas fa-file-alt me-2 text-muted" style="font-size: 0.85rem;"></i>
                                {{ dossier.documents|length }}
                            </td>
                            <td style="padding: 0.4rem 0.35rem !important; font-size: 0.8rem; line-height: 1.4;">
                                <i class="fas fa-calendar me-2 text-muted" style="font-size: 0.85rem;"></i>
                                {{ dossier.createdAt|date('d/m/Y') }}
                            </td>
                            <td class="text-center" style="padding: 0.4rem 0.35rem !important; font-size: 0.8rem; line-height: 1.4;">
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('responsable_view_dossier_documents', {'id': dossier.id}) }}" 
                                       class="btn btn-outline-primary btn-xs" style="font-size: 0.75rem; padding: 0.25rem 0.4rem; line-height: 1.25;">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('responsable_edit_dossier', {'id': dossier.id}) }}" 
                                       class="btn btn-outline-secondary btn-xs" style="font-size: 0.75rem; padding: 0.25rem 0.4rem; line-height: 1.25;">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <!-- Pagination -->
    {% if dossiers.pageCount > 1 %}
        <div class="d-flex justify-content-center" style="flex-shrink: 0; padding: 0.3rem 0; margin-top: 0.3rem;">
            {{ knp_pagination_render(dossiers, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
        </div>
    {% endif %}
    {% else %}
    <!-- État vide simple -->
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">Aucun dossier</h4>
            <p class="text-muted mb-3">Ce placard ne contient aucun dossier pour le moment.</p>
            <a href="{{ path('responsable_manage_dossiers') }}" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Créer un Dossier
            </a>
        </div>
    </div>
    {% endif %}
</div>

<script>
    // Fonctionnalité de recherche
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const clearButton = document.getElementById('clearSearch');
        const dossierRows = document.querySelectorAll('.dossier-row');

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();
                let visibleCount = 0;

                dossierRows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    if (text.includes(searchTerm)) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                // Mettre à jour le compteur
                const counter = document.querySelector('.badge.bg-secondary');
                if (counter) {
                    counter.textContent = `${visibleCount} dossier${visibleCount > 1 ? 's' : ''}`;
                }
            });
        }

        if (clearButton) {
            clearButton.addEventListener('click', function() {
                searchInput.value = '';
                dossierRows.forEach(row => {
                    row.style.display = '';
                });
                searchInput.focus();
                
                // Remettre le compteur original
                const counter = document.querySelector('.badge.bg-secondary');
                if (counter) {
                    counter.textContent = '{{ dossiers.totalItemCount }} dossier{{ dossiers.totalItemCount > 1 ? "s" : "" }}';
                }
            });
        }
    });
</script>

<style>
    .compact-table tbody tr:last-child {
        border-bottom: none;
    }
    
    .compact-table tbody tr:last-child td {
        padding-bottom: 0.4rem !important;
    }
    
    .pagination {
        margin-bottom: 0 !important;
    }
    
    .pagination .page-link {
        padding: 0.3rem 0.5rem;
        font-size: 0.8rem;
        line-height: 1.25;
    }
    
    .pagination .page-item {
        margin: 0 0.1rem;
    }
    
    @media (max-width: 767px) {
        h2 {
            font-size: 1rem !important;
        }
        
        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .btn {
            width: 100%;
        }
        
        .col-md-6.text-end {
            text-align: left !important;
            margin-top: 0.5rem;
        }
    }
</style>
{% endblock %}

