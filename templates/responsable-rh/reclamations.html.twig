{% extends 'base.html.twig' %}

{% block title %}Gestion des Réclamations{% endblock %}

{% block body %}
<div class="row g-0">
    <div class="col-12">
        <div class="card compact-page">
            <div class="card-header compact-header py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-1"></i>Gestion des Réclamations
                    </h4>
                    <div class="d-flex gap-1 align-items-center flex-wrap">
                        <a href="{{ path('responsable_manage_reclamations') }}?filter=en_attente" 
                           class="btn btn-xs {% if currentFilter == 'en_attente' %}btn-warning{% else %}btn-outline-warning{% endif %}">
                            En Attente
                        </a>
                        <a href="{{ path('responsable_manage_reclamations') }}?filter=traitees" 
                           class="btn btn-xs {% if currentFilter == 'traitees' %}btn-success{% else %}btn-outline-success{% endif %}">
                            Traitées
                        </a>
                        <a href="{{ path('responsable_manage_reclamations') }}" 
                           class="btn btn-xs {% if currentFilter == 'all' %}btn-primary{% else %}btn-outline-primary{% endif %}">
                            Toutes
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body compact-body p-2">
                {% if reclamations|length == 0 %}
                    <div class="alert alert-info alert-xs py-2 px-3 text-center mb-0">
                        <small><i class="fas fa-exclamation-triangle me-1"></i>Aucune réclamation trouvée.</small>
                    </div>
                {% else %}
                    <div class="table-responsive compact-table">
                        <table class="table table-sm table-hover table-striped mb-0 compact-table-inner">
                            <thead class="table-light">
                                <tr>
                                    <th style="padding: 0.25rem;">Employé</th>
                                    <th style="padding: 0.25rem;">Manager</th>
                                    <th style="padding: 0.25rem;">Type</th>
                                    <th style="padding: 0.25rem;">Date</th>
                                    <th style="padding: 0.25rem;">Statut</th>
                                    <th style="padding: 0.25rem;">Doc</th>
                                    <th style="padding: 0.25rem;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reclamation in reclamations %}
                                <tr>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">
                                        <strong>{{ reclamation.employe.prenom|slice(0, 8) }} {{ reclamation.employe.nom|slice(0, 8) }}</strong>
                                        <br><small class="text-muted" style="font-size: 0.7rem;">{{ reclamation.employe.email|slice(0, 18) }}...</small>
                                    </td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">
                                        {{ reclamation.manager.prenom|slice(0, 8) }} {{ reclamation.manager.nom|slice(0, 8) }}
                                    </td>
                                    <td style="padding: 0.25rem;">
                                        <span class="badge" style="font-size: 0.7rem; padding: 0.2rem 0.4rem; background-color: #fff3cd; color: #856404;">
                                            {{ reclamation.typeReclamationLabel|slice(0, 12) }}
                                        </span>
                                    </td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ reclamation.dateCreation|date('d/m/Y') }}</td>
                                    <td style="padding: 0.25rem;">
                                        <span class="badge status-{{ reclamation.statutBadgeClass }}" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">
                                            {{ reclamation.statutLabel }}
                                        </span>
                                    </td>
                                    <td style="padding: 0.25rem;">
                                        {% if reclamation.documentPath %}
                                            <a href="/uploads/reclamations/{{ reclamation.documentPath|split('/')|last }}" target="_blank" class="btn btn-xs btn-outline-info py-0 px-1">
                                                <i class="fas fa-file" style="font-size: 0.7rem;"></i>
                                            </a>
                                        {% else %}
                                            <span class="text-muted" style="font-size: 0.75rem;">-</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 0.25rem;">
                                        <a href="{{ path('responsable_traiter_reclamation', {'id': reclamation.id}) }}" 
                                           class="btn btn-xs {% if reclamation.statut == 'en_attente' %}btn-warning{% else %}btn-outline-primary{% endif %} py-0 px-1">
                                            <i class="fas fa-{% if reclamation.statut == 'en_attente' %}edit{% else %}eye{% endif %}" style="font-size: 0.7rem;"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
            
            <div class="card-footer compact-footer py-1 px-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <label for="perPageSelect" class="mb-0 small text-muted" style="font-size: 0.75rem;">
                            <i class="fas fa-list-ul"></i> Par page:
                        </label>
                        <select id="perPageSelect" class="form-select form-select-sm" style="width: auto; font-size: 0.75rem; padding: 0.125rem 1.5rem 0.125rem 0.5rem;" onchange="changePerPage(this.value)">
                            <option value="10" {{ (perPage ?? 10) == 10 ? 'selected' : '' }}>10</option>
                            <option value="20" {{ (perPage ?? 10) == 20 ? 'selected' : '' }}>20</option>
                            <option value="30" {{ (perPage ?? 10) == 30 ? 'selected' : '' }}>30</option>
                            <option value="50" {{ (perPage ?? 10) == 50 ? 'selected' : '' }}>50</option>
                            <option value="100" {{ (perPage ?? 10) == 100 ? 'selected' : '' }}>100</option>
                        </select>
                    </div>
                    {% if reclamations.pageCount > 1 %}
                        <div>
                            {{ knp_pagination_render(reclamations, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        overflow: hidden !important;
    }
    
    .main-content {
        overflow: hidden !important;
        height: 100vh;
        display: flex;
        flex-direction: column;
    }
    
    .main-area {
        padding: 0 !important;
        overflow: hidden;
        flex: 1;
        min-height: 0;
    }
    
    .container-fluid {
        height: 100%;
        padding: 0.5rem 0.75rem !important;
        overflow: hidden;
    }
    
    .row.g-0 {
        margin: 0;
        height: 100%;
    }
    
    .compact-page {
        margin-bottom: 0;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    
    .compact-header {
        padding: 0.4rem 0.75rem !important;
        background-color: #f8fafc;
        border-bottom: 1px solid #bcccdc;
        flex-shrink: 0;
    }
    
    .compact-header h4 {
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
    }
    
    .compact-body {
        padding: 0.4rem !important;
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
    }
    
    .compact-table {
        margin: 0;
        overflow-x: visible;
        overflow-y: visible;
    }
    
    .compact-table table {
        width: 100%;
    }
    
    @media (max-width: 768px) {
        .compact-table {
            overflow-x: auto;
        }
    }
    
    .compact-table-inner {
        margin-bottom: 0;
        font-size: 0.875rem;
    }
    
    .compact-table-inner th,
    .compact-table-inner td {
        font-size: 0.8rem;
        vertical-align: middle;
        padding: 0.2rem 0.25rem !important;
        line-height: 1.3;
    }
    
    .compact-table-inner thead th {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        background-color: #f8f9fa;
    }
    
    .compact-table-inner tbody tr {
        background-color: #ffffff;
    }
    
    .compact-table-inner tbody tr:hover {
        background-color: #d9eafd !important;
    }
    
    .btn-xs {
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 0.2rem;
    }
    
    .alert-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        margin-bottom: 0.5rem;
    }
    
    .compact-footer {
        padding: 0.2rem 0.5rem !important;
        background-color: #f8f9fa;
        border-top: 1px solid #bcccdc;
        flex-shrink: 0;
    }
    
    .compact-footer .pagination {
        margin-bottom: 0;
    }
    
    .compact-footer .pagination .page-link {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }
    
    .pagination {
        font-size: 0.75rem;
    }
    
    .pagination .page-link {
        padding: 0.2rem 0.4rem;
    }
    
    .status-warning {
        background-color: #fff3cd;
        color: #856404;
    }
    
    .status-info {
        background-color: #d1ecf1;
        color: #0c5460;
    }
    
    .status-success {
        background-color: #d4edda;
        color: #155724;
    }
    
    .status-danger {
        background-color: #f8d7da;
        color: #721c24;
    }
    
    @media (max-width: 767px) {
        .compact-header .d-flex {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 0.5rem;
        }
        
    }
</style>

<script>
function changePerPage(value) {
    const url = new URL(window.location.href);
    url.searchParams.set('perPage', value);
    url.searchParams.set('page', '1'); // Reset to first page when changing perPage
    window.location.href = url.toString();
}
</script>
{% endblock %}
