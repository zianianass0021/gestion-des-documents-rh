{% extends 'base.html.twig' %}

{% block title %}Documents du Dossier - {{ dossier.nom }}{% endblock %}

{% block body %}
<div class="row g-0">
    <div class="col-12">
        <div class="card compact-page">
            <div class="card-header compact-header py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h4 class="mb-0">
                            <i class="fas fa-file-alt me-1"></i>
                            Documents du Dossier
                        </h4>
                        <small class="text-muted">
                            <strong>{{ dossier.nom }}</strong> - {{ dossier.employe.prenom }} {{ dossier.employe.nom }}
                        </small>
                    </div>
                    <div>
                        <a href="{{ path('responsable_manage_dossiers') }}" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Retour
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body compact-body p-2">
                <!-- Document Requirements Section -->
                {% if documentRequirements is not empty %}
                    <!-- Progress Bar -->
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="fw-bold">Progression: <span class="badge bg-primary">{{ completionPercentage }}%</span></small>
                        </div>
                        <div class="progress" style="height: 18px;">
                            <div class="progress-bar {% if completionPercentage == 100 %}bg-success{% elseif completionPercentage >= 70 %}bg-warning{% else %}bg-danger{% endif %}" 
                                 role="progressbar" 
                                 style="width: {{ completionPercentage }}%" 
                                 aria-valuenow="{{ completionPercentage }}" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                                <small>{{ completionPercentage }}%</small>
                            </div>
                        </div>
                    </div>

                    <!-- Document Requirements List -->
                    <h6 class="mb-2"><i class="fas fa-list me-1"></i>Documents Requis par Contrat</h6>
                    
                    <!-- Documents Obligatoires -->
                    <small class="text-danger d-block mb-1">
                        <i class="fas fa-exclamation-triangle me-1"></i>Documents Obligatoires
                    </small>
                    <div class="table-responsive mb-2">
                        <table class="table table-sm table-hover mb-0 compact-table-inner">
                            <thead>
                                <tr>
                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Document</th>
                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Contrat</th>
                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Statut Ajout</th>
                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Statut Téléchargement</th>
                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for requirement in documentRequirements %}
                                    {% if requirement.required %}
                                    <tr>
                                        <td style="padding: 0.2rem 0.25rem !important;">
                                            <strong style="font-size: 0.8rem;">{{ requirement.abbreviation }}</strong>
                                            {% if requirement.document %}
                                                <br><small class="text-muted" style="font-size: 0.7rem;">{{ requirement.document.libelleComplet|slice(0, 30) }}{% if requirement.document.libelleComplet|length > 30 %}...{% endif %}</small>
                                            {% endif %}
                                        </td>
                                        <td style="padding: 0.2rem 0.25rem !important;">
                                            <span class="badge bg-info" style="font-size: 0.65rem;" title="{{ requirement.contractType }}">{{ requirement.contractType|slice(0, 15) }}{% if requirement.contractType|length > 15 %}...{% endif %}</span>
                                        </td>
                                        <td style="padding: 0.2rem 0.25rem !important;">
                                            {% if requirement.document %}
                                                <a href="{{ path('responsable_toggle_statut_ajout', {'id': requirement.document.id}) }}" 
                                                   class="badge {% if requirement.document.statutAjout == 'ajoute' %}bg-success{% else %}bg-danger{% endif %} text-decoration-none"
                                                   style="cursor: pointer;"
                                                   title="Cliquer pour marquer comme {% if requirement.document.statutAjout == 'ajoute' %}non ajouté{% else %}ajouté{% endif %}">
                                                    <i class="fas {% if requirement.document.statutAjout == 'ajoute' %}fa-check{% else %}fa-times{% endif %} me-1"></i>
                                                    {% if requirement.document.statutAjout == 'ajoute' %}Ajouté{% else %}Non ajouté{% endif %}
                                                </a>
                                            {% else %}
                                                <a href="{{ path('responsable_toggle_statut_ajout_new', {'dossier_id': dossier.id, 'abbreviation': requirement.abbreviation}) }}" 
                                                   class="badge bg-danger text-decoration-none"
                                                   style="cursor: pointer;"
                                                   title="Cliquer pour marquer comme ajouté">
                                                    <i class="fas fa-times me-1"></i>Non ajouté
                                                </a>
                                            {% endif %}
                                        </td>
                                        <td style="padding: 0.2rem 0.25rem !important;">
                                            {% if requirement.document %}
                                                <span class="badge {% if requirement.document.statutTelechargement == 'telecharge' %}bg-success{% else %}bg-warning{% endif %}" style="font-size: 0.65rem;">
                                                    <i class="fas {% if requirement.document.statutTelechargement == 'telecharge' %}fa-check{% else %}fa-clock{% endif %} me-1"></i>
                                                    {% if requirement.document.statutTelechargement == 'telecharge' %}Téléchargé{% else %}Non téléchargé{% endif %}
                                                </span>
                                                {% if requirement.document.uploadedBy and requirement.document.statutTelechargement == 'telecharge' %}
                                                    <br><small class="text-muted" style="font-size: 0.65rem;">Par: {{ requirement.document.uploadedBy|slice(0, 15) }}{% if requirement.document.uploadedBy|length > 15 %}...{% endif %}</small>
                                                {% endif %}
                                            {% else %}
                                                <span class="badge bg-warning" style="font-size: 0.65rem;">
                                                    <i class="fas fa-clock me-1"></i>Non téléchargé
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td style="padding: 0.2rem 0.25rem !important;">
                                            <div class="btn-group btn-group-xs" role="group">
                                                {% if requirement.document and requirement.document.statutTelechargement == 'telecharge' %}
                                                    <a href="{{ path('responsable_download_document', {'id': requirement.document.id}) }}" 
                                                       class="btn btn-xs btn-outline-success py-0 px-1" title="Télécharger" style="font-size: 0.7rem;">
                                                        <i class="fas fa-download"></i>
                                                    </a>
                                                {% endif %}
                                                <a href="{{ path('responsable_upload_document', {'dossier_id': dossier.id, 'abbreviation': requirement.abbreviation}) }}" 
                                                   class="btn btn-xs {% if requirement.document and requirement.document.statutTelechargement == 'telecharge' %}btn-warning{% else %}btn-primary{% endif %} py-0 px-1"
                                                   title="{% if requirement.document and requirement.document.statutTelechargement == 'telecharge' %}Modifier le fichier{% else %}Uploader un fichier{% endif %}" style="font-size: 0.7rem;">
                                                    <i class="fas {% if requirement.document and requirement.document.statutTelechargement == 'telecharge' %}fa-edit{% else %}fa-upload{% endif %}"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Documents Complémentaires -->
                    <small class="text-secondary d-block mb-1 mt-2">
                        <i class="fas fa-plus-circle me-1"></i>Documents Complémentaires
                    </small>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 compact-table-inner">
                            <thead>
                                <tr>
                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Document</th>
                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Contrat</th>
                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Statut Ajout</th>
                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Statut Téléchargement</th>
                                    <th style="padding: 0.25rem; font-size: 0.75rem;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for requirement in documentRequirements %}
                                    {% if not requirement.required %}
                                    <tr>
                                        <td style="padding: 0.2rem 0.25rem !important;">
                                            <strong style="font-size: 0.8rem;">{{ requirement.abbreviation }}</strong>
                                            {% if requirement.document %}
                                                <br><small class="text-muted" style="font-size: 0.7rem;">{{ requirement.document.libelleComplet|slice(0, 30) }}{% if requirement.document.libelleComplet|length > 30 %}...{% endif %}</small>
                                            {% endif %}
                                        </td>
                                        <td style="padding: 0.2rem 0.25rem !important;">
                                            <span class="badge bg-info" style="font-size: 0.65rem;" title="{{ requirement.contractType }}">{{ requirement.contractType|slice(0, 15) }}{% if requirement.contractType|length > 15 %}...{% endif %}</span>
                                        </td>
                                        <td style="padding: 0.2rem 0.25rem !important;">
                                            {% if requirement.document %}
                                                <a href="{{ path('responsable_toggle_statut_ajout', {'id': requirement.document.id}) }}" 
                                                   class="badge {% if requirement.document.statutAjout == 'ajoute' %}bg-success{% else %}bg-secondary{% endif %} text-decoration-none"
                                                   style="cursor: pointer;"
                                                   title="Cliquer pour marquer comme {% if requirement.document.statutAjout == 'ajoute' %}non ajouté{% else %}ajouté{% endif %}">
                                                    <i class="fas {% if requirement.document.statutAjout == 'ajoute' %}fa-check{% else %}fa-minus{% endif %} me-1"></i>
                                                    {% if requirement.document.statutAjout == 'ajoute' %}Ajouté{% else %}Non ajouté{% endif %}
                                                </a>
                                            {% else %}
                                                <a href="{{ path('responsable_toggle_statut_ajout_new', {'dossier_id': dossier.id, 'abbreviation': requirement.abbreviation}) }}" 
                                                   class="badge bg-secondary text-decoration-none"
                                                   style="cursor: pointer;"
                                                   title="Cliquer pour marquer comme ajouté">
                                                    <i class="fas fa-minus me-1"></i>Non ajouté
                                                </a>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if requirement.document %}
                                                <span class="badge {% if requirement.document.statutTelechargement == 'telecharge' %}bg-success{% else %}bg-secondary{% endif %}">
                                                    <i class="fas {% if requirement.document.statutTelechargement == 'telecharge' %}fa-check{% else %}fa-clock{% endif %} me-1"></i>
                                                    {% if requirement.document.statutTelechargement == 'telecharge' %}Téléchargé{% else %}Non téléchargé{% endif %}
                                                </span>
                                                {% if requirement.document.uploadedBy and requirement.document.statutTelechargement == 'telecharge' %}
                                                    <br><small class="text-muted">Par: {{ requirement.document.uploadedBy }}</small>
                                                {% endif %}
                                            {% else %}
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-clock me-1"></i>Non téléchargé
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                {% if requirement.document and requirement.document.statutTelechargement == 'telecharge' %}
                                                    <a href="{{ path('responsable_download_document', {'id': requirement.document.id}) }}" 
                                                       class="btn btn-sm btn-outline-success" title="Télécharger">
                                                        <i class="fas fa-download"></i>
                                                    </a>
                                                {% endif %}
                                                <a href="{{ path('responsable_upload_document', {'dossier_id': dossier.id, 'abbreviation': requirement.abbreviation}) }}" 
                                                   class="btn btn-sm {% if requirement.document and requirement.document.statutTelechargement == 'telecharge' %}btn-warning{% else %}btn-outline-primary{% endif %}"
                                                   title="{% if requirement.document and requirement.document.statutTelechargement == 'telecharge' %}Modifier le fichier{% else %}Uploader un fichier{% endif %}">
                                                    <i class="fas {% if requirement.document and requirement.document.statutTelechargement == 'telecharge' %}fa-edit{% else %}fa-upload{% endif %}"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    
                {% endif %}
            </div>
        </div>
    </div>
</div>

<style>
    .compact-page {
        margin-bottom: 0;
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    
    .compact-header {
        padding: 0.4rem 0.75rem !important;
        background-color: #ffffff;
        border-bottom: 1px solid #bcccdc;
        flex-shrink: 0;
    }
    
    .compact-header h4 {
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
    }
    
    .compact-body {
        padding: 0.4rem !important;
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
    }
    
    .compact-table-inner {
        margin-bottom: 0;
        font-size: 0.875rem;
    }
    
    .compact-table-inner th,
    .compact-table-inner td {
        font-size: 0.8rem;
        vertical-align: middle;
        padding: 0.2rem 0.25rem !important;
        line-height: 1.3;
    }
    
    .compact-table-inner thead th {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        background-color: #ffffff;
    }
    
    .compact-table-inner tbody tr {
        background-color: #ffffff !important;
    }
    
    .compact-table-inner tbody tr:hover {
        background-color: #d9eafd !important;
    }
    
    .alert-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        margin-bottom: 0.5rem;
    }
    
    .progress {
        font-size: 0.7rem;
    }
    
    .btn-sm {
        padding: 0.2rem 0.4rem;
        font-size: 0.75rem;
    }
    
    .btn-xs {
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 0.2rem;
    }
    
    .btn-group-xs .btn {
        padding: 0.1rem 0.3rem;
        font-size: 0.7rem;
    }
    
    .badge {
        font-size: 0.7rem;
        padding: 0.2rem 0.4rem;
    }
    
    .table-responsive {
        overflow-x: visible;
    }
    
    @media (max-width: 768px) {
        .table-responsive {
            overflow-x: auto;
        }
        
        .compact-header {
            padding: 0.3rem 0.5rem !important;
        }
        
        .compact-body {
            padding: 0.3rem !important;
        }
    }
</style>
{% endblock %}
