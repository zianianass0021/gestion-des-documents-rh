{% extends 'base.html.twig' %}

{% block title %}Assigner Employé à Organisation{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0 text-gray-800">
                        <i class="fas fa-user-plus me-2"></i>
                        Assigner Employé à Organisation
                    </h1>
                    <p class="text-muted mb-0">Lier un employé à une organisation</p>
                </div>
                <div>
                    <a href="{{ path('responsable_manage_organisations') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Retour
                    </a>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8">
                    <div class="card shadow">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">
                                <i class="fas fa-link me-2"></i>
                                Assignation
                            </h6>
                        </div>
                        <div class="card-body">
                            {{ form_start(form) }}
                            
                            <div class="mb-3">
                                {{ form_label(form.organisation, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.organisation, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.organisation) }}
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Contrat Employé</label>
                                
                                <!-- Barre de recherche unique avec autocomplétion -->
                                <div class="position-relative">
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-search"></i>
                                        </span>
                                        <input type="text" 
                                               id="employee-search" 
                                               class="form-control" 
                                               placeholder="Rechercher un employé (nom ou prénom) - minimum 2 caractères"
                                               autocomplete="off">
                                        <button type="button" class="btn btn-outline-secondary" id="clear-search" style="display:none;">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                    
                                    <!-- Zone de résultats déroulante -->
                                    <div id="search-results" class="list-group position-absolute w-100" style="display:none; z-index:1000; max-height: 300px; overflow-y: auto; background: white; border: 1px solid #ced4da; border-top: none; border-radius: 0 0 0.375rem 0.375rem;">
                                    </div>
                                </div>
                                
                                <small class="text-muted d-block mt-2" id="search-status">
                                    <i class="fas fa-info-circle"></i> Tapez au moins 2 caractères pour rechercher dans la base de données.
                                </small>
                                
                                <div id="loading-indicator" style="display:none;" class="mt-2">
                                    <small class="text-info">
                                        <i class="fas fa-spinner fa-spin"></i> Recherche en cours...
                                    </small>
                                </div>
                                
                                <!-- Champ caché pour stocker l'ID du contrat sélectionné -->
                                <input type="hidden" 
                                       id="employee-contrat-id" 
                                       name="organisation_employee_contrat[employeeContrat]"
                                       value="{{ form.employeeContrat.vars.value }}">
                                
                                <!-- Cacher le champ du formulaire original -->
                                <div style="display:none;">
                                    {{ form_widget(form.employeeContrat) }}
                                </div>
                                
                                <!-- Affichage du contrat sélectionné -->
                                <div id="selected-contract" class="mt-2" style="display:none;">
                                    <div class="alert alert-success d-flex justify-content-between align-items-center">
                                        <span>
                                            <i class="fas fa-check-circle me-2"></i>
                                            <strong id="selected-contract-name"></strong>
                                        </span>
                                        <button type="button" class="btn btn-sm btn-outline-danger" id="remove-selection">
                                            <i class="fas fa-times"></i> Retirer
                                        </button>
                                    </div>
                                </div>
                                
                                {{ form_errors(form.employeeContrat) }}
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.dateDebut) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.dateFin, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.dateFin, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.dateFin) }}
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between">
                                <a href="{{ path('responsable_manage_organisations') }}" class="btn btn-secondary">
                                    <i class="fas fa-times me-2"></i>Annuler
                                </a>
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-link me-2"></i>Assigner
                                </button>
                            </div>

                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card shadow">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">
                                <i class="fas fa-info-circle me-2"></i>
                                Information
                            </h6>
                        </div>
                        <div class="card-body">
                            <h6>Assignation Organisation</h6>
                            <p class="text-muted small">
                                Cette fonctionnalité permet de lier un employé (via son contrat) à une organisation spécifique.
                            </p>
                            
                            <h6 class="mt-3">Étapes :</h6>
                            <ol class="text-muted small">
                                <li>Sélectionner l'organisation</li>
                                <li>Choisir le contrat employé</li>
                                <li>Définir les dates d'assignation</li>
                                <li>Valider l'assignation</li>
                            </ol>
                            
                            <div class="alert alert-info mt-3">
                                <i class="fas fa-lightbulb me-2"></i>
                                <strong>Conseil :</strong> La date de fin est optionnelle pour les assignations en cours.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('employee-search');
    const searchResults = document.getElementById('search-results');
    const contratIdInput = document.getElementById('employee-contrat-id');
    const selectedContract = document.getElementById('selected-contract');
    const selectedContractName = document.getElementById('selected-contract-name');
    const clearBtn = document.getElementById('clear-search');
    const searchStatus = document.getElementById('search-status');
    const loadingIndicator = document.getElementById('loading-indicator');
    let searchTimeout;
    
    // Afficher les résultats dans la liste déroulante
    function displayResults(contrats, searchTerm = '') {
        searchResults.innerHTML = '';
        
        if (contrats.length === 0) {
            const noResult = document.createElement('div');
            noResult.className = 'list-group-item text-muted text-center';
            noResult.textContent = searchTerm ? `Aucun contrat trouvé pour "${searchTerm}"` : 'Aucun résultat';
            searchResults.appendChild(noResult);
            searchResults.style.display = 'block';
            searchStatus.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Aucun résultat trouvé pour "${searchTerm}"`;
            return;
        }
        
        contrats.forEach(contrat => {
            const item = document.createElement('a');
            item.href = '#';
            item.className = 'list-group-item list-group-item-action';
            item.style.cursor = 'pointer';
            item.innerHTML = `
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>${contrat.label}</strong>
                    </div>
                    <i class="fas fa-chevron-right text-muted"></i>
                </div>
            `;
            
            item.addEventListener('click', function(e) {
                e.preventDefault();
                selectContract(contrat.id, contrat.label);
            });
            
            searchResults.appendChild(item);
        });
        
        searchResults.style.display = 'block';
        searchStatus.innerHTML = `<i class="fas fa-check-circle text-success"></i> ${contrats.length} contrat${contrats.length > 1 ? 's' : ''} trouvé${contrats.length > 1 ? 's' : ''}`;
    }
    
    // Sélectionner un contrat
    function selectContract(contratId, contratLabel) {
        contratIdInput.value = contratId;
        // Mettre à jour aussi le champ du formulaire caché si présent
        const formSelect = document.querySelector('select[name="organisation_employee_contrat[employeeContrat]"]');
        if (formSelect) {
            formSelect.value = contratId;
        }
        selectedContractName.textContent = contratLabel;
        selectedContract.style.display = 'block';
        searchInput.value = '';
        searchResults.style.display = 'none';
        clearBtn.style.display = 'none';
        searchStatus.innerHTML = `<i class="fas fa-check-circle text-success"></i> Contrat sélectionné avec succès.`;
    }
    
    // Recherche AJAX
    function performSearch(searchTerm) {
        if (searchTerm.trim().length < 2) {
            searchResults.style.display = 'none';
            searchStatus.innerHTML = `<i class="fas fa-info-circle"></i> Tapez au moins 2 caractères pour rechercher.`;
            loadingIndicator.style.display = 'none';
            return;
        }
        
        loadingIndicator.style.display = 'block';
        searchStatus.innerHTML = `<i class="fas fa-search"></i> Recherche de "${searchTerm}"...`;
        searchResults.style.display = 'none';
        
        fetch(`{{ path('api_search_employee_contrats') }}?search=${encodeURIComponent(searchTerm)}`)
            .then(response => response.json())
            .then(data => {
                loadingIndicator.style.display = 'none';
                displayResults(data.contrats, searchTerm);
            })
            .catch(error => {
                loadingIndicator.style.display = 'none';
                console.error('Erreur lors de la recherche:', error);
                searchStatus.innerHTML = `<i class="fas fa-exclamation-triangle text-danger"></i> Erreur lors de la recherche. Veuillez réessayer.`;
                searchResults.style.display = 'none';
            });
    }
    
    // Recherche en temps réel avec debounce
    searchInput.addEventListener('input', function() {
        const searchTerm = this.value.trim();
        
        clearTimeout(searchTimeout);
        
        if (searchTerm.length >= 2) {
            clearBtn.style.display = 'block';
            searchTimeout = setTimeout(() => {
                performSearch(searchTerm);
            }, 300);
        } else if (searchTerm.length === 0) {
            clearBtn.style.display = 'none';
            searchResults.style.display = 'none';
            searchStatus.innerHTML = `<i class="fas fa-info-circle"></i> Tapez au moins 2 caractères pour rechercher dans la base de données.`;
        }
    });
    
    // Fermer les résultats si on clique en dehors
    document.addEventListener('click', function(e) {
        if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
            searchResults.style.display = 'none';
        }
    });
    
    // Entrée pour déclencher la recherche immédiatement
    searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && this.value.trim().length >= 2) {
            e.preventDefault();
            clearTimeout(searchTimeout);
            performSearch(this.value.trim());
        } else if (e.key === 'Escape') {
            searchResults.style.display = 'none';
        }
    });
    
    // Bouton pour effacer la recherche
    clearBtn.addEventListener('click', function() {
        searchInput.value = '';
        this.style.display = 'none';
        loadingIndicator.style.display = 'none';
        searchResults.style.display = 'none';
        searchStatus.innerHTML = `<i class="fas fa-info-circle"></i> Tapez au moins 2 caractères pour rechercher dans la base de données.`;
    });
    
    // Bouton pour retirer la sélection
    document.getElementById('remove-selection').addEventListener('click', function() {
        contratIdInput.value = '';
        selectedContract.style.display = 'none';
        searchInput.focus();
        searchStatus.innerHTML = `<i class="fas fa-info-circle"></i> Tapez au moins 2 caractères pour rechercher dans la base de données.`;
    });
});
</script>
<style>
#search-results {
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
}
#search-results .list-group-item:hover {
    background-color: #f8f9fa;
}
</style>
{% endblock %}
