<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Système RH Professionnel{% endblock %}</title>
    <meta name="description" content="{% block description %}Système de gestion des ressources humaines moderne et professionnel{% endblock %}">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏢</text></svg>">
    
    <!-- Bootstrap 5.3.2 -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome 6.5.1 -->
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Animate.css -->
        <link href="https://cdn.jsdelivr.net/npm/animate.css@4.1.1/animate.min.css" rel="stylesheet">
    
    <!-- AOS -->
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
    
    <!-- Custom CSS -->
        {% block stylesheets %}
        <script>
        // Removed prefetch script for faster navigation
        </script>
        <style>
            /* ===== PAGINATION STYLES ===== */
            .pagination {
                margin-bottom: 0;
            }
            
            .pagination .page-link {
                color: #3a4652;
                border-color: var(--border-color);
                background-color: #ffffff;
                padding: 0.5rem 0.75rem;
                font-size: 0.875rem;
                transition: all 0.2s ease;
            }
            
            .pagination .page-link:hover {
                color: #2a3642;
                background-color: var(--bg-tertiary);
                border-color: var(--primary-300);
            }
            
            .pagination .page-item.active .page-link {
                background-color: #5a6672;
                border-color: #5a6672;
                color: white;
            }
            
            .pagination .page-item.disabled .page-link {
                color: #9aa6b2;
                background-color: #f8fafc;
                border-color: var(--border-color);
                cursor: not-allowed;
            }
            
            .pagination-info {
                font-size: 0.875rem;
            }
            
            @media (max-width: 768px) {
                .pagination .page-link {
                    padding: 0.375rem 0.5rem;
                    font-size: 0.8rem;
                }
                
                .pagination-info {
                    font-size: 0.75rem;
                }
            }
            /* ===== LIGHT MODE ONLY SYSTEM ===== */
            
            /* Light Theme Colors - Color Hunt Palette */
            :root {
                /* Primary Colors - Based on Color Hunt Palette */
                --primary-50: #f8fafc;
                --primary-100: #d9eafd;
                --primary-200: #d9eafd;
                --primary-300: #bcccdc;
                --primary-400: #bcccdc;
                --primary-500: #9aa6b2;
                --primary-600: #9aa6b2;
                --primary-700: #8a96a2;
                --primary-800: #7a8692;
                --primary-900: #6a7682;
                
                /* Secondary Colors - Based on Color Hunt Palette */
                --secondary-50: #f8fafc;
                --secondary-100: #d9eafd;
                --secondary-200: #bcccdc;
                --secondary-300: #bcccdc;
                --secondary-400: #9aa6b2;
                --secondary-500: #9aa6b2;
                --secondary-600: #8a96a2;
                --secondary-700: #7a8692;
                --secondary-800: #6a7682;
                --secondary-900: #5a6672;
                
                /* Light Theme Colors - Color Hunt Palette */
                --bg-primary: #ffffff;
                --bg-secondary: #f8fafc;
                --bg-tertiary: #d9eafd;
                --text-primary: #000000;
                --text-secondary: #000000;
                --text-muted: #000000;
                --border-color: #bcccdc;
                --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
                --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
                --radius: 0.5rem;
                --radius-lg: 0.75rem;
                --transition: all 0.3s ease;
            }
            
            /* Global Styles */
            * {
                box-sizing: border-box;
            }
            
            html, body {
                margin: 0;
                padding: 0;
                overflow-x: hidden;
                width: 100%;
                max-width: 100vw;
            }
            
            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-secondary);
                color: #000000;
            }
            
            .container-fluid {
                padding-left: 0.75rem;
                padding-right: 0.75rem;
                max-width: 100%;
                overflow-x: hidden;
            }
            
            /* App Layout */
            .app-wrapper {
                display: flex;
                min-height: 100vh;
                width: 100%;
                max-width: 100vw;
                overflow-x: hidden;
            }
            
            .main-content {
                flex: 1;
                display: flex;
                flex-direction: column;
                margin-left: 180px;
                transition: margin-left 0.3s ease;
                width: 100%;
                max-width: 100%;
                overflow-x: hidden;
                height: 100vh;
                overflow-y: hidden;
            }
            
            .main-content.expanded {
                margin-left: 0;
        }
        
            .main-area {
                flex: 1;
                position: relative;
                min-height: 0;
                padding: 0;
                width: 100%;
                max-width: 100%;
                overflow-x: hidden;
                overflow-y: hidden;
                height: 100%;
            }
            
            /* Card Styles */
            .card {
                background-color: var(--bg-primary);
                border-color: var(--border-color);
                color: #000000;
                max-width: 100%;
                overflow-x: hidden;
            }
            
            .row {
                margin-left: 0;
                margin-right: 0;
                max-width: 100%;
            }
            
            .row > * {
                padding-left: calc(var(--bs-gutter-x) * 0.5);
                padding-right: calc(var(--bs-gutter-x) * 0.5);
            }
            
            .card-header {
                background-color: var(--bg-tertiary);
                border-bottom-color: var(--border-color);
                color: #000000;
            }

            .card-body {
                color: #000000;
            }
            
            .card-title {
            color: #000000;
            }
            
            .card-text {
            color: #000000;
            }
            
            /* Table Styles */
            .table {
                color: #000000;
                width: 100%;
                max-width: 100%;
            }
            
            .table-responsive {
                width: 100%;
                max-width: 100%;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
        
        .table thead th {
                background-color: var(--bg-tertiary);
                border-color: var(--border-color);
                color: #000000;
            }
            
            .table tbody tr {
                background-color: var(--bg-primary);
                border-color: var(--border-color);
            color: #000000;
        }
        
        .table tbody tr:hover {
                background-color: var(--bg-tertiary);
            }
            
            .table td {
                border-color: var(--border-color);
                color: #000000;
            }
            
            /* Form Styles */
            .form-control,
            .form-select {
                background-color: var(--bg-primary);
            border-color: var(--border-color);
            color: #000000;
        }
        
            .form-control::placeholder {
                color: #666666;
            }
            
            /* Button Styles */
            .btn-outline-primary,
            .btn-outline-secondary,
            .btn-outline-info,
            .btn-outline-success,
            .btn-outline-warning,
            .btn-outline-danger {
            color: #000000;
            border-color: var(--border-color);
            }
            
            .btn-outline-primary:hover,
            .btn-outline-secondary:hover,
            .btn-outline-info:hover,
            .btn-outline-success:hover,
            .btn-outline-warning:hover,
            .btn-outline-danger:hover {
                background-color: var(--bg-tertiary);
            color: #000000;
            }
            
            /* User Dropdown Styles */
            .user-dropdown {
                position: relative;
                display: inline-block;
            }
            
            .user-dropdown-menu {
                position: absolute;
                top: calc(100% + 5px);
                right: 0;
                background-color: var(--bg-primary);
                border: 1px solid var(--border-color);
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                min-width: 200px;
                z-index: 9999;
                display: none;
                margin-top: 0;
            }
            
            .user-dropdown-menu.show {
                display: block;
            }
            
            .user-dropdown-item {
                display: block;
                padding: 0.75rem 1rem;
                color: #000000;
                text-decoration: none;
                transition: var(--transition);
                border-radius: var(--radius);
                margin: 0.25rem;
            }
            
            .user-dropdown-item:hover {
                background-color: var(--bg-tertiary);
                color: #000000;
                text-decoration: none;
            }
            
            .user-dropdown-item i {
                width: 20px;
                text-align: center;
            }
            
            /* Ensure dropdown is always visible */
            .navbar-area .d-flex {
                overflow: visible;
            }
            
            .navbar-area .d-flex > div {
                overflow: visible;
            }

                /* Sidebar Styles */
        .sidebar {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 180px;
                    height: 100vh;
                    background: #bcccdc;
                    z-index: 1000;
                    transition: transform 0.15s ease;
        }

            .sidebar.collapsed {
                transform: translateX(-180px);
            }
            
            .sidebar-header {
                background: #bcccdc;
                border-bottom: 1px solid #9aa6b2;
                padding: 0.75rem;
                text-align: center;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            
            .sidebar-brand {
            color: #3a4652;
                font-size: 1rem;
                font-weight: 600;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
            }
            
            .logo-img {
                height: 100px;
                width: auto;
                max-width: 100%;
                object-fit: contain;
                display: block;
                margin: 0 auto;
            }
            
            .sidebar.collapsed .logo-img {
                height: 70px;
            }
            
            .sidebar-menu {
                padding: 0.5rem 0;
            }
            
            .sidebar-menu a {
                color: #3a4652;
                text-decoration: none;
                transition: background-color 0.15s ease, color 0.15s ease;
            }

            .sidebar-menu a:hover {
                background: rgba(255, 255, 255, 0.5);
                color: #2a3642;
            }
            
            .sidebar-menu a.active {
                background: rgba(255, 255, 255, 0.6);
                border-right: 4px solid #4a5662;
                color: #2a3642;
                font-weight: 600;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            }
            
            .sidebar-menu a.active i {
                color: #2a3642;
            }

            .sidebar-menu a i {
                color: #3a4652;
            }

            .sidebar-menu a:hover i {
                color: #2a3642;
            }

            /* Submenu styles */
            .has-submenu {
                position: relative;
            }

            .submenu-toggle {
                position: relative;
            }

            .submenu-arrow {
                transition: transform 0.15s ease;
                font-size: 0.75rem;
                color: #3a4652;
            }

            .has-submenu.active .submenu-arrow {
                transform: rotate(180deg);
            }

            .submenu {
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.15s ease;
                background: rgba(0, 0, 0, 0.1);
            }

            .has-submenu.active .submenu {
                max-height: 200px;
            }

            .submenu a {
                padding-left: 2rem !important;
                padding-right: 1rem !important;
                white-space: nowrap;
                color: #3a4652;
            }

            .submenu a:hover {
                color: #2a3642;
            }

            .submenu a span {
                white-space: nowrap;
                overflow: visible;
            }

            .has-submenu.active > .submenu-toggle {
                background: rgba(255, 255, 255, 0.6);
                border-right: 4px solid #4a5662;
                color: #2a3642;
                font-weight: 600;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            }
            
            /* Navbar Styles */
            .navbar-area {
                background-color: var(--bg-primary);
                border-bottom: 1px solid var(--border-color);
                padding: 0.5rem 0;
                box-shadow: var(--shadow);
                overflow: visible;
                position: relative;
            }
            
            .nav-toggle-btn {
                background: none;
                border: none;
                color: #000000;
                font-size: 1.2rem;
                cursor: pointer;
                transition: color 0.3s ease;
            }
            
            .nav-toggle-btn:hover {
                color: #000000;
            }
            
            .nav-title {
                color: #000000;
                font-size: 1.2rem;
                font-weight: 600;
            }
            
            .nav-user-btn {
                background-color: var(--bg-tertiary);
                border: 1px solid var(--border-color);
                color: #000000;
                padding: 0.5rem 1rem;
                border-radius: var(--radius);
            transition: all 0.3s ease;
        }

            .nav-user-btn:hover {
                background-color: var(--bg-secondary);
                color: #000000;
            }
            
            /* Ensure all text on light backgrounds is black */
            .card-header:not(.dark-header):not([class*="bg-"]):not([class*="text-white"]),
            .card-header:not(.dark-header) h1,
            .card-header:not(.dark-header) h2,
            .card-header:not(.dark-header) h3,
            .card-header:not(.dark-header) h4,
            .card-header:not(.dark-header) h5,
            .card-header:not(.dark-header) h6,
            .card-body,
            .card-body h1,
            .card-body h2,
            .card-body h3,
            .card-body h4,
            .card-body h5,
            .card-body h6,
            .card-body p,
            .card-body small,
            .card-body span:not([class*="badge"]):not([class*="btn"]),
            .text-muted:not([class*="bg-"]):not([class*="text-white"]),
            body {
                color: #000000;
            }
            
            /* ===== RESPONSIVE MEDIA QUERIES ===== */
            
            /* Large Desktop (1400px and up) */
            @media (min-width: 1400px) {
                .container-fluid {
                    max-width: 1320px;
                    margin: 0 auto;
                }
            }
            
            /* Desktop (992px to 1399px) */
            @media (min-width: 992px) and (max-width: 1399px) {
                .sidebar {
                    width: 180px;
                }
                
                .main-content {
                    margin-left: 180px;
                }
                
                .container-fluid {
                    padding-left: 1rem;
                    padding-right: 1rem;
                }
            }
            
            /* Tablet (768px to 991px) */
            @media (max-width: 991px) {
                .sidebar {
                    width: 200px;
                    transform: translateX(-200px);
                    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
                }
                
                .sidebar.show {
                    transform: translateX(0);
                }
                
                .main-content {
                    margin-left: 0 !important;
                    width: 100%;
                }
                
                .navbar-area {
                    padding: 0.75rem 0;
                }
                
                .nav-title {
                    font-size: 1rem;
                }
                
                .container-fluid {
                    padding-left: 0.75rem;
                    padding-right: 0.75rem;
                }
                
                /* Make tables scrollable on tablet */
                .table-responsive {
                    overflow-x: auto;
                    -webkit-overflow-scrolling: touch;
                }
                
                /* Adjust card spacing */
                .card {
                    margin-bottom: 1rem;
                }
                
                /* Stack columns on tablet */
                .row > [class*="col-"] {
                    margin-bottom: 1rem;
                }
            }
            
            /* Mobile (576px to 767px) */
            @media (max-width: 767px) {
                .sidebar {
                    width: 250px;
                    transform: translateX(-250px);
                }
                
                .sidebar.show {
                    transform: translateX(0);
                }
                
                .main-content {
                    margin-left: 0 !important;
                }
                
                .main-area {
                    padding: 0.75rem 0;
                }
                
                .container-fluid {
                    padding-left: 0.5rem !important;
                    padding-right: 0.5rem !important;
                }
                
                .navbar-area {
                    padding: 0.5rem 0;
                }
                
                .nav-title {
                    font-size: 0.9rem;
                }
                
                .nav-user-btn {
                    padding: 0.4rem 0.8rem;
                    font-size: 0.85rem;
                }
                
                .container-fluid {
                    padding-left: 0.5rem;
                    padding-right: 0.5rem;
                }
                
                /* Card adjustments */
                .card {
                    margin-bottom: 0.75rem;
                }
                
                .card-header {
                    padding: 0.75rem;
                }
                
                .card-body {
                    padding: 0.75rem;
                }
                
                /* Button adjustments */
                .btn {
                    font-size: 0.85rem;
                    padding: 0.4rem 0.8rem;
                }
                
                .btn-group .btn {
                    padding: 0.3rem 0.6rem;
                }
                
                /* Table adjustments */
                .table {
                    font-size: 0.85rem;
                }
                
                .table th,
                .table td {
                    padding: 0.5rem;
                }
                
                /* Form adjustments */
                .form-control,
                .form-select {
                    font-size: 0.9rem;
                }
                
                /* Hide long text on mobile */
                .text-truncate-mobile {
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                    max-width: 150px;
                }
                
                /* Stack action buttons vertically */
                .btn-group-vertical-mobile {
                    display: flex;
                    flex-direction: column;
                    gap: 0.25rem;
                }
                
                .btn-group-vertical-mobile .btn {
                    width: 100%;
                }
                
                /* User dropdown mobile fixes */
                .user-dropdown-menu {
                    width: 180px !important;
                    max-width: 180px !important;
                }
            }
            
            /* Small Mobile (up to 575px) */
            @media (max-width: 575px) {
                .sidebar {
                    width: 280px;
                    transform: translateX(-280px);
                }
                
                .sidebar.show {
                    transform: translateX(0);
                }
                
                .sidebar-menu a {
                    padding: 0.75rem 1rem !important;
                    font-size: 0.9rem;
                }
                
                .main-area {
                    padding: 0.5rem 0;
                }
                
                .container-fluid {
                    padding-left: 0.25rem !important;
                    padding-right: 0.25rem !important;
                    width: 100% !important;
                    max-width: 100% !important;
                    overflow-x: hidden !important;
                }
                
                /* User dropdown small mobile fixes */
                .user-dropdown-menu {
                    width: 160px !important;
                    max-width: 160px !important;
                }
                
                .row {
                    margin-left: 0 !important;
                    margin-right: 0 !important;
                    width: 100% !important;
                    max-width: 100% !important;
                }
                
                .card {
                    width: 100% !important;
                    max-width: 100% !important;
                    overflow-x: hidden !important;
                }
                
                .card-body {
                    padding: 0.75rem !important;
                    overflow-x: hidden !important;
                }
                
                .table-responsive {
                    overflow-x: auto !important;
                    -webkit-overflow-scrolling: touch;
                    width: 100%;
                    max-width: 100%;
                }
                
                /* Simple responsive fixes */
                img, video, iframe, embed, object {
                    max-width: 100%;
                    height: auto;
                }
                
                .table-responsive {
                    overflow-x: auto;
                    -webkit-overflow-scrolling: touch;
                }
                
                .btn {
                    font-size: 0.85rem;
                    padding: 0.4rem 0.8rem;
                }
                
                .badge {
                    font-size: 0.75rem;
                }
                
                /* Navbar adjustments */
                .navbar-area .d-flex {
                    flex-wrap: wrap;
                    gap: 0.5rem;
                }
                
                .nav-title {
                    font-size: 0.85rem;
                }
                
                .nav-user-btn {
                    padding: 0.3rem 0.6rem;
                    font-size: 0.8rem;
                }
                
                /* Card adjustments */
                .card-header h1,
                .card-header h2,
                .card-header h3 {
                    font-size: 1.1rem !important;
                }
                
                .card-header h4,
                .card-header h5 {
                    font-size: 1rem !important;
                }
                
                /* Table adjustments */
                .table {
                    font-size: 0.75rem;
                }
                
                .table th,
                .table td {
                    padding: 0.4rem;
                }
                
                /* Hide less important columns on small mobile */
                .hide-on-small-mobile {
                    display: none !important;
                }
                
                /* Badge adjustments */
                .badge {
                    font-size: 0.7rem;
                    padding: 0.25rem 0.4rem;
                }
                
                /* Form adjustments */
                .form-label {
                    font-size: 0.85rem;
                }
                
                .form-control,
                .form-select {
                    font-size: 0.85rem;
                    padding: 0.4rem 0.6rem;
                }
                
                /* Alert adjustments */
                .alert {
                    font-size: 0.85rem;
                    padding: 0.75rem;
                }
                
                /* Progress bar adjustments */
                .progress {
                    height: 20px !important;
                }
                
                /* Modal adjustments */
                .modal-dialog {
                    margin: 0.5rem;
                }
                
                .modal-content {
                    font-size: 0.85rem;
                }
            }
            
            /* Sidebar overlay for mobile/tablet */
            @media (max-width: 991px) {
                .sidebar-overlay {
                    display: none;
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background-color: rgba(0, 0, 0, 0.5);
                    z-index: 999;
                }
                
                .sidebar-overlay.show {
                    display: block;
                }
            }
            
            /* Print styles */
            @media print {
                .sidebar,
                .navbar-area,
                .btn,
                .nav-toggle-btn {
                    display: none !important;
                }
                
                .main-content {
                    margin-left: 0 !important;
                }
                
                .card {
                    break-inside: avoid;
                }
            }
        </style>
        {% endblock %}
    </head>
    <body>
        <div class="app-wrapper">
            <!-- Sidebar Overlay (for mobile/tablet) -->
            <div class="sidebar-overlay" id="sidebarOverlay"></div>
            
            <!-- Sidebar -->
            <div class="sidebar" id="sidebar">
                <div class="sidebar-header">
                    <div class="sidebar-brand">
                        <img src="{{ asset('logo.png') }}?v={{ 'now'|date('U') }}" alt="Système RH" class="logo-img">
                    </div>
                </div>
                <nav class="sidebar-menu">
                    {% set userRoles = app.user ? app.user.roles : [] %}
                    {% if 'ROLE_ADMINISTRATEUR_RH' not in userRoles and 'ROLE_MANAGER' not in userRoles %}
                        <a href="{{ path('app_dashboard') }}" class="d-flex align-items-center px-4 py-3{% if app.request.get('_route') == 'app_dashboard' %} active{% endif %}">
                            <i class="fas fa-tachometer-alt"></i>
                            <span class="ms-3">Dashboard</span>
                        </a>
                    {% endif %}
                    
