{% extends 'base.html.twig' %}

{% block title %}Mon Dossier{% endblock %}

{% block body %}
<div class="row g-0">
    <div class="col-12">
        <div class="card compact-page">
            <div class="card-header compact-header py-2">
                <h4 class="mb-0">
                    <i class="fas fa-folder me-1"></i>Mon Dossier
                </h4>
            </div>
            <div class="card-body compact-body p-2">
                {% if dossiers is empty %}
                    <div class="alert alert-info alert-xs py-2 px-3 text-center mb-0">
                        <small><i class="fas fa-info-circle me-1"></i>Aucun dossier trouvé.</small>
                    </div>
                {% else %}
                    <div class="table-responsive compact-table">
                        <table class="table table-sm table-hover table-striped mb-0 compact-table-inner">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 150px; padding: 0.25rem;">Titre</th>
                                    <th style="width: 80px; padding: 0.25rem;">Type</th>
                                    <th style="width: 250px; padding: 0.25rem;">Description</th>
                                    <th style="width: 100px; padding: 0.25rem;">Date</th>
                                    <th style="width: 80px; padding: 0.25rem;">Documents</th>
                                    <th style="width: 70px; padding: 0.25rem;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for dossier in dossiers %}
                                <tr>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ dossier.nom|slice(0, 20) }}{% if dossier.nom|length > 20 %}...{% endif %}</td>
                                    <td style="padding: 0.25rem;">
                                        <span class="badge bg-info" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">{{ dossier.status|title }}</span>
                                    </td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ dossier.description ? (dossier.description|slice(0, 35) ~ (dossier.description|length > 35 ? '...' : '')) : '-' }}</td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ dossier.createdAt|date('d/m/Y') }}</td>
                                    <td style="padding: 0.25rem;">
                                        <span class="badge bg-secondary" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">{{ dossier.documentCount }}</span>
                                    </td>
                                    <td style="padding: 0.25rem;">
                                        <a href="{{ path('employee_dossier_detail', {'id': dossier.id}) }}" 
                                           class="btn btn-primary btn-xs py-0 px-1">
                                            <i class="fas fa-eye" style="font-size: 0.7rem;"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<style>
    .compact-page {
        margin-bottom: 0;
    }
    
    .compact-header {
        padding: 0.5rem 0.75rem !important;
        background-color: #f8fafc;
        border-bottom: 1px solid #bcccdc;
    }
    
    .compact-header h4 {
        font-size: 1.1rem;
        font-weight: 600;
    }
    
    .compact-body {
        padding: 0.5rem !important;
        max-height: calc(100vh - 280px);
        overflow-y: auto;
    }
    
    .compact-table {
        margin: 0;
    }
    
    .compact-table-inner {
        margin-bottom: 0;
        font-size: 0.875rem;
    }
    
    .compact-table-inner th,
    .compact-table-inner td {
        font-size: 0.8rem;
        vertical-align: middle;
    }
    
    .compact-table-inner thead th {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        background-color: #f8f9fa;
    }
    
    .btn-xs {
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 0.2rem;
    }
    
    .alert-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        margin-bottom: 0.5rem;
    }
</style>
{% endblock %}
