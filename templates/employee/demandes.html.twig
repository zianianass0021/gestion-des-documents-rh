{% extends 'base.html.twig' %}

{% block title %}Mes Demandes et Réclamations{% endblock %}

{% block body %}
<div class="row g-0">
    <div class="col-12">
        <div class="card compact-page">
            <div class="card-header compact-header py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h4 class="mb-0">
                        <i class="fas fa-envelope me-1"></i>Mes Demandes et Réclamations
                    </h4>
                    <a href="{{ path('employee_nouvelle_demande') }}" class="btn btn-success btn-xs">
                        <i class="fas fa-plus"></i> Nouvelle Demande
                    </a>
                </div>
            </div>
            <div class="card-body compact-body p-2">
                {% if demandes is empty %}
                    <div class="alert alert-info alert-xs py-2 px-3 text-center mb-0">
                        <small><i class="fas fa-info-circle me-1"></i>Aucune demande envoyée.</small>
                    </div>
                {% else %}
                    <div class="table-responsive compact-table">
                        <table class="table table-sm table-hover table-striped mb-0 compact-table-inner">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 200px; padding: 0.25rem;">Titre</th>
                                    <th style="width: 100px; padding: 0.25rem;">Date envoi</th>
                                    <th style="width: 80px; padding: 0.25rem;">Statut</th>
                                    <th style="width: 100px; padding: 0.25rem;">Date réponse</th>
                                    <th style="width: 70px; padding: 0.25rem;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for demande in demandes %}
                                <tr>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">
                                        <strong>{{ demande.titre|slice(0, 30) }}{% if demande.titre|length > 30 %}...{% endif %}</strong>
                                        <br><small class="text-muted" style="font-size: 0.7rem;">{{ demande.contenu|slice(0, 40) }}...</small>
                                    </td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ demande.dateCreation|date('d/m/Y') }}</td>
                                    <td style="padding: 0.25rem;">
                                        <span class="badge bg-{{ demande.statutCouleur }}" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">
                                            {{ demande.statutLibelle }}
                                        </span>
                                    </td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">
                                        {% if demande.dateReponse %}
                                            {{ demande.dateReponse|date('d/m/Y') }}
                                        {% else %}
                                            <span class="text-muted" style="font-size: 0.75rem;">-</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 0.25rem;">
                                        <a href="{{ path('employee_voir_demande', {'id': demande.id}) }}" 
                                           class="btn btn-outline-primary btn-xs py-0 px-1" 
                                           title="Voir">
                                            <i class="fas fa-eye" style="font-size: 0.7rem;"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
            
            {% if demandes.pageCount > 1 %}
                <div class="card-footer compact-footer py-1 px-2">
                    <div class="d-flex justify-content-center">
                        {{ knp_pagination_render(demandes, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
    .compact-page {
        margin-bottom: 0;
    }
    
    .compact-header {
        padding: 0.5rem 0.75rem !important;
        background-color: #F8FAFC;
        border-bottom: 1px solid #BCCCDC;
    }
    
    .compact-header h4 {
        font-size: 1.1rem;
        font-weight: 600;
    }
    
    .compact-body {
        padding: 0.5rem !important;
        max-height: calc(100vh - 280px);
        overflow-y: auto;
    }
    
    .compact-table {
        margin: 0;
    }
    
    .compact-table-inner {
        margin-bottom: 0;
        font-size: 0.875rem;
    }
    
    .compact-table-inner th,
    .compact-table-inner td {
        font-size: 0.8rem;
        vertical-align: middle;
    }
    
    .compact-table-inner thead th {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        background-color: #F8FAFC;
    }
    
    .btn-xs {
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 0.2rem;
    }
    
    .alert-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        margin-bottom: 0.5rem;
    }
    
    .compact-footer {
        padding: 0.25rem 0.5rem !important;
        background-color: #F8FAFC;
        border-top: 1px solid #BCCCDC;
    }
    
    .compact-footer .pagination {
        margin-bottom: 0;
    }
    
    .compact-footer .pagination .page-link {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }
    
    .pagination {
        font-size: 0.75rem;
    }
    
    .pagination .page-link {
        padding: 0.2rem 0.4rem;
    }
</style>
{% endblock %}
