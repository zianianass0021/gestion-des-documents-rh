{% extends 'base.html.twig' %}

{% block title %}Mes Contrats - Système RH{% endblock %}

{% block body %}
<div class="row g-0">
    <div class="col-12">
        <div class="card compact-page">
            <div class="card-header compact-header py-2">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="fas fa-file-contract me-1"></i>Mes Contrats
                        <small class="text-muted ms-2" style="font-size: 0.75rem;">({{ contrats.getTotalItemCount }})</small>
                    </h4>
                </div>
            </div>
            <div class="card-body compact-body p-2">
                {% if contrats.getTotalItemCount == 0 %}
                    <div class="alert alert-info alert-xs py-2 px-3 text-center mb-0">
                        <small><i class="fas fa-info-circle me-1"></i>Aucun contrat trouvé.</small>
                    </div>
                {% else %}
                    <div class="table-responsive compact-table">
                        <table class="table table-sm table-hover table-striped mb-0 compact-table-inner">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 200px; padding: 0.25rem;">Type de Contrat</th>
                                    <th style="width: 100px; padding: 0.25rem;">Date Début</th>
                                    <th style="width: 100px; padding: 0.25rem;">Date Fin</th>
                                    <th style="width: 80px; padding: 0.25rem;">Statut</th>
                                    <th style="width: 70px; padding: 0.25rem;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for contrat in contrats %}
                                <tr>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ contrat.natureContrat.designation }}</td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ contrat.dateDebut|date('d/m/Y') }}</td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ contrat.dateFin ? contrat.dateFin|date('d/m/Y') : '-' }}</td>
                                    <td style="padding: 0.25rem;">
                                        {% if contrat.statut == 'actif' %}
                                            <span class="badge bg-success" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">Actif</span>
                                        {% elseif contrat.statut == 'terminé' %}
                                            <span class="badge bg-secondary" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">Terminé</span>
                                        {% else %}
                                            <span class="badge bg-warning" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">{{ contrat.statut|title }}</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 0.25rem;">
                                        <a href="{{ path('employee_view_contrat', {'id': contrat.id}) }}" class="btn btn-outline-primary btn-xs py-0 px-1" title="Voir détails">
                                            <i class="fas fa-eye" style="font-size: 0.7rem;"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
            
            {% if contrats.pageCount > 1 %}
                <div class="card-footer compact-footer py-1 px-2">
                    <div class="d-flex justify-content-center">
                        {{ knp_pagination_render(contrats, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
    .compact-page {
        margin-bottom: 0;
    }
    
    .compact-header {
        padding: 0.5rem 0.75rem !important;
        background-color: #f8fafc;
        border-bottom: 1px solid #bcccdc;
    }
    
    .compact-header h4 {
        font-size: 1.1rem;
        font-weight: 600;
    }
    
    .compact-body {
        padding: 0.5rem !important;
        max-height: calc(100vh - 280px);
        overflow-y: auto;
    }
    
    .compact-table {
        margin: 0;
    }
    
    .compact-table-inner {
        margin-bottom: 0;
        font-size: 0.875rem;
    }
    
    .compact-table-inner th,
    .compact-table-inner td {
        font-size: 0.8rem;
        vertical-align: middle;
    }
    
    .compact-table-inner thead th {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        background-color: #f8f9fa;
    }
    
    .btn-xs {
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 0.2rem;
    }
    
    .alert-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        margin-bottom: 0.5rem;
    }
    
    .compact-footer {
        padding: 0.25rem 0.5rem !important;
        background-color: #f8f9fa;
        border-top: 1px solid #bcccdc;
    }
    
    .compact-footer .pagination {
        margin-bottom: 0;
    }
    
    .compact-footer .pagination .page-link {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }
    
    .pagination {
        font-size: 0.75rem;
    }
    
    .pagination .page-link {
        padding: 0.2rem 0.4rem;
    }
</style>
{% endblock %}
