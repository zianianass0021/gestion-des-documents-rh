{% extends 'base.html.twig' %}

{% block title %}Détails du Contrat - Système RH{% endblock %}

{% block body %}
<div class="row g-0">
    <div class="col-12">
        <div class="card compact-page">
            <div class="card-header compact-header py-2">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="fas fa-file-contract me-1"></i>Détails du Contrat
                    </h4>
                    <a href="{{ path('employee_contrats') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>
            <div class="card-body compact-body p-3">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="detail-section">
                            <label class="detail-label">Type de Contrat</label>
                            <div class="detail-value">{{ contrat.natureContrat.designation }}</div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="detail-section">
                            <label class="detail-label">Statut</label>
                            <div class="detail-value">
                                {% if contrat.statut == 'actif' %}
                                    <span class="badge bg-success" style="font-size: 0.85rem; padding: 0.3rem 0.6rem;">Actif</span>
                                {% elseif contrat.statut == 'terminé' %}
                                    <span class="badge bg-secondary" style="font-size: 0.85rem; padding: 0.3rem 0.6rem;">Terminé</span>
                                {% else %}
                                    <span class="badge bg-warning" style="font-size: 0.85rem; padding: 0.3rem 0.6rem;">{{ contrat.statut|title }}</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="detail-section">
                            <label class="detail-label">Date de Début</label>
                            <div class="detail-value">{{ contrat.dateDebut|date('d/m/Y') }}</div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="detail-section">
                            <label class="detail-label">Date de Fin</label>
                            <div class="detail-value">
                                {% if contrat.dateFin %}
                                    {{ contrat.dateFin|date('d/m/Y') }}
                                {% else %}
                                    <span class="text-muted">Non définie</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    {% if contrat.salaire %}
                    <div class="col-md-6 mb-3">
                        <div class="detail-section">
                            <label class="detail-label">Salaire</label>
                            <div class="detail-value">{{ contrat.salaire }} MAD</div>
                        </div>
                    </div>
                    {% endif %}
                    {% if contrat.organisationEmployeeContrats is not empty %}
                    <div class="col-12 mb-3">
                        <div class="detail-section">
                            <label class="detail-label">Organisations</label>
                            <div class="detail-value">
                                <ul class="list-unstyled mb-0">
                                    {% for orgContrat in contrat.organisationEmployeeContrats %}
                                    <li class="mb-2">
                                        <i class="fas fa-building me-2 text-primary"></i>
                                        <strong>{{ orgContrat.organisation.dossierDesignation }}</strong>
                                        <br>
                                        <small class="text-muted ms-4">
                                            Du {{ orgContrat.dateDebut|date('d/m/Y') }}
                                            {% if orgContrat.dateFin %}
                                                au {{ orgContrat.dateFin|date('d/m/Y') }}
                                            {% else %}
                                                (en cours)
                                            {% endif %}
                                        </small>
                                    </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .compact-page {
        margin-bottom: 0;
    }
    
    .compact-header {
        padding: 0.5rem 0.75rem !important;
        background-color: #F8FAFC;
        border-bottom: 1px solid #BCCCDC;
    }
    
    .compact-header h4 {
        font-size: 1.1rem;
        font-weight: 600;
    }
    
    .compact-body {
        padding: 1rem !important;
    }
    
    .detail-section {
        padding: 0.75rem;
        background-color: #F8FAFC;
        border-radius: 8px;
        border: 1px solid #BCCCDC;
    }
    
    .detail-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #5a6672;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
        display: block;
    }
    
    .detail-value {
        font-size: 0.95rem;
        color: #000000;
        font-weight: 500;
    }
    
    .detail-value ul {
        margin-top: 0.5rem;
    }
    
    .detail-value li {
        padding: 0.5rem;
        background-color: #ffffff;
        border-radius: 6px;
        border-left: 3px solid #9AA6B2;
    }
</style>
{% endblock %}

