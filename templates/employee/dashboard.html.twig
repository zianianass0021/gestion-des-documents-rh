{% extends 'base.html.twig' %}

{% block title %}Dashboard Employé{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .border-left-primary { border-left: 0.25rem solid #9AA6B2 !important; }
        .border-left-success { border-left: 0.25rem solid #BCCCDC !important; }
        .border-left-info { border-left: 0.25rem solid #D9EAFD !important; }
        .border-left-warning { border-left: 0.25rem solid #9AA6B2 !important; }
        .text-xs { font-size: 0.7rem; }
        .text-gray-800 { color: #000000 !important; }
        .text-gray-300 { color: #BCCCDC !important; }
        .chart-area { position: relative; height: 8rem; width: 100%; }
        .chart-pie { position: relative; height: 10rem; width: 100%; }
    </style>
{% endblock %}

{% block body %}
<style>
    .main-content {
        padding-bottom: 0 !important;
    }
    .container-fluid {
        padding-bottom: 0 !important;
    }
    body {
        padding-bottom: 0 !important;
        margin-bottom: 0 !important;
    }
    .row:last-child {
        margin-bottom: 0 !important;
    }
    .card:last-child {
        margin-bottom: 0 !important;
    }
    #mainContent {
        padding-bottom: 0 !important;
    }
</style>
<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-1 animate-fade-in-down">
    <h1 class="h3 mb-0 text-gray-800 animate-fade-in-left" style="font-size: 1.25rem;">
        <i class="fas fa-tachometer-alt me-2 animate-bounce"></i>Dashboard Employé
    </h1>
    <div class="text-muted animate-fade-in-right" style="font-size: 0.8rem;">
        <i class="fas fa-user me-1 animate-float"></i>{{ employee.prenom }} {{ employee.nom }}
    </div>
</div>

<!-- KPIs Personnels -->
<div class="row mb-1 animate-stagger">
    <div class="col-xl-3 col-md-6 mb-1">
        <div class="card border-left-primary h-100 animate-fade-in-up">
            <div class="card-body" style="padding: 0.6rem 0.75rem !important;">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-0" style="font-size: 0.65rem;">
                            Mes Contrats
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800" style="font-size: 1.3rem;">
                            {{ contrats|length }}
                        </div>
                        <div class="text-xs text-muted" style="font-size: 0.65rem;">
                            Contrats actifs
                        </div>
                    </div>
                    <div class="col-auto">
                        <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #F8FAFC 0%, #D9EAFD 100%); border: 1px solid #BCCCDC; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-file-contract" style="font-size: 1.1rem; color: #5a6672;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-1">
        <div class="card border-left-success h-100">
            <div class="card-body" style="padding: 0.6rem 0.75rem !important;">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-0" style="font-size: 0.65rem;">
                            Progression Dossier
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800" style="font-size: 1.3rem;">
                            {{ completionRate }}%
                        </div>
                        <div class="text-xs text-muted" style="font-size: 0.65rem;">
                            {{ uploadedRequiredDocsCount }}/{{ requiredDocsCount }} documents
                        </div>
                    </div>
                    <div class="col-auto">
                        <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #F8FAFC 0%, #D9EAFD 100%); border: 1px solid #BCCCDC; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-chart-pie" style="font-size: 1.1rem; color: #5a6672;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-1">
        <div class="card border-left-info h-100">
            <div class="card-body" style="padding: 0.6rem 0.75rem !important;">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-0" style="font-size: 0.65rem;">
                            Documents Consultables
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800" style="font-size: 1.3rem;">
                            {{ employeeDocuments|length }}
                        </div>
                        <div class="text-xs text-muted" style="font-size: 0.65rem;">
                            Dans mon dossier
                        </div>
                    </div>
                    <div class="col-auto">
                        <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #F8FAFC 0%, #D9EAFD 100%); border: 1px solid #BCCCDC; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-eye" style="font-size: 1.1rem; color: #5a6672;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-1">
        <div class="card border-left-warning h-100">
            <div class="card-body" style="padding: 0.6rem 0.75rem !important;">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-0" style="font-size: 0.65rem;">
                            Mes Demandes
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800" style="font-size: 1.3rem;">
                            {{ demandesCount }}
                        </div>
                        <div class="text-xs text-muted" style="font-size: 0.65rem;">
                            Demandes envoyées
                        </div>
                    </div>
                    <div class="col-auto">
                        <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #F8FAFC 0%, #D9EAFD 100%); border: 1px solid #BCCCDC; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-envelope" style="font-size: 1.1rem; color: #5a6672;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Graphiques et Informations -->
<div class="row mb-1">
    <!-- Graphique des Contrats -->
    <div class="col-xl-4 col-lg-5 mb-1">
        <div class="card mb-1">
            <div class="card-header" style="padding: 0.4rem 0.75rem !important;">
                <h6 class="m-0 font-weight-bold text-primary" style="font-size: 0.85rem;">
                    <i class="fas fa-chart-pie me-2"></i>Statut des Contrats
                </h6>
            </div>
            <div class="card-body" style="padding: 0.5rem !important;">
                <div class="chart-pie" style="height: 10rem;">
                    <canvas id="contratsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Graphique des Dossiers -->
    <div class="col-xl-4 col-lg-5 mb-1">
        <div class="card mb-1">
            <div class="card-header" style="padding: 0.4rem 0.75rem !important;">
                <h6 class="m-0 font-weight-bold text-success" style="font-size: 0.85rem;">
                    <i class="fas fa-chart-pie me-2"></i>Progression des Documents
                </h6>
            </div>
            <div class="card-body" style="padding: 0.5rem !important;">
                <div class="chart-pie" style="height: 10rem;">
                    <canvas id="dossiersChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Informations Personnelles -->
    <div class="col-xl-4 col-lg-5 mb-1">
        <div class="card mb-1">
            <div class="card-header" style="padding: 0.4rem 0.75rem !important;">
                <h6 class="m-0 font-weight-bold text-info" style="font-size: 0.85rem;">
                    <i class="fas fa-user me-2"></i>Informations Personnelles
                </h6>
            </div>
            <div class="card-body" style="padding: 0.6rem !important;">
                <div class="text-center">
                    <div class="mb-1">
                        <div style="width: 50px; height: 50px; background: linear-gradient(135deg, #F8FAFC 0%, #D9EAFD 100%); border: 2px solid #BCCCDC; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                            <i class="fas fa-user-circle" style="font-size: 1.75rem; color: #5a6672;"></i>
                        </div>
                    </div>
                    <h5 class="font-weight-bold text-gray-800" style="font-size: 0.9rem; margin-bottom: 0.3rem;">{{ employee.prenom }} {{ employee.nom }}</h5>
                    {% if employee.employeeContrats is not empty %}
                        {% set currentContrat = employee.employeeContrats|first %}
                        {% if currentContrat.organisationEmployeeContrats is not empty %}
                            {% set currentOrg = currentContrat.organisationEmployeeContrats|first.organisation %}
                            <p class="text-muted mb-1" style="font-size: 0.75rem;">{{ currentOrg.dossierDesignation }}</p>
                        {% endif %}
                    {% endif %}
                    
                    <div class="row text-center">
                        <div class="col-12 mb-1">
                            <small class="text-muted" style="font-size: 0.65rem;">Email</small><br>
                            <strong style="font-size: 0.75rem;">{{ employee.email }}</strong>
                        </div>
                    </div>
                    
                    <div class="mt-1">
                        <span class="badge bg-success" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">
                            <i class="fas fa-check-circle me-1"></i>Actif
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Actions Rapides -->
<div class="row mb-0">
    <div class="col-12">
        <div class="card mb-0" style="margin-bottom: 0 !important;">
            <div class="card-header dark-header" style="padding: 0.4rem 0.75rem !important;">
                <h6 class="m-0 font-weight-bold" style="font-size: 0.85rem;">
                    <i class="fas fa-bolt me-2"></i>Actions Rapides
                </h6>
            </div>
            <div class="card-body" style="padding: 0.75rem 0.75rem 0.4rem 0.75rem !important;">
                <div class="row g-2 justify-content-center">
                    <div class="col-auto">
                        <a href="{{ path('employee_profile') }}" class="quick-action-link">
                            <div class="quick-action-icon-wrapper">
                                <i class="fas fa-user"></i>
                            </div>
                            <span class="quick-action-label">Mon Profil</span>
                        </a>
                    </div>
                    <div class="col-auto">
                        <a href="{{ path('employee_contrats') }}" class="quick-action-link">
                            <div class="quick-action-icon-wrapper">
                                <i class="fas fa-file-contract"></i>
                            </div>
                            <span class="quick-action-label">Mes Contrats</span>
                        </a>
                    </div>
                    <div class="col-auto">
                        <a href="{{ path('employee_dossiers') }}" class="quick-action-link">
                            <div class="quick-action-icon-wrapper">
                                <i class="fas fa-folder"></i>
                            </div>
                            <span class="quick-action-label">Mon Dossier</span>
                        </a>
                    </div>
                    <div class="col-auto">
                        <a href="{{ path('employee_demandes') }}" class="quick-action-link">
                            <div class="quick-action-icon-wrapper">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <span class="quick-action-label">Mes Demandes</span>
                        </a>
                    </div>
                    <div class="col-auto">
                        <a href="{{ path('employee_nouvelle_demande') }}" class="quick-action-link">
                            <div class="quick-action-icon-wrapper quick-action-icon-primary">
                                <i class="fas fa-plus"></i>
                            </div>
                            <span class="quick-action-label">Nouvelle Demande</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    /* Remove all bottom spacing */
    .main-content > .container-fluid > .row:last-child,
    .main-content > .container-fluid > .row:last-child > .col-12,
    .main-content > .container-fluid > .row:last-child .card {
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
    }
</style>
<!-- Scripts pour les graphiques -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Graphique des contrats
const contratsCtx = document.getElementById('contratsChart').getContext('2d');
const contratsChart = new Chart(contratsCtx, {
    type: 'doughnut',
    data: {
        labels: ['Actifs', 'Expirés', 'Suspendus'],
        datasets: [{
            data: [
                {{ contrats|filter(c => c.statut == 'actif')|length }},
                {{ contrats|filter(c => c.statut == 'expire')|length }},
                {{ contrats|filter(c => c.statut == 'suspendu')|length }}
            ],
            backgroundColor: ['#1cc88a', '#e74a3b', '#f6c23e'],
            hoverBackgroundColor: ['#17a673', '#c0392b', '#d68910'],
            hoverBorderColor: "rgba(234, 236, 244, 1)",
        }],
    },
    options: {
        maintainAspectRatio: false,
        responsive: true,
        plugins: {
            legend: {
                position: 'bottom'
            }
        }
    }
});

// Graphique des dossiers
const dossiersCtx = document.getElementById('dossiersChart').getContext('2d');
const dossiersChart = new Chart(dossiersCtx, {
    type: 'doughnut',
    data: {
        labels: ['Complétés', 'En cours', 'En attente'],
        datasets: [{
            data: [
                {{ dossiersWithRealStatus|filter(d => d.realStatus == 'completed')|length }},
                {{ dossiersWithRealStatus|filter(d => d.realStatus == 'in_progress')|length }},
                {{ dossiersWithRealStatus|filter(d => d.realStatus == 'pending')|length }}
            ],
            backgroundColor: ['#1cc88a', '#36b9cc', '#858796'],
            hoverBackgroundColor: ['#17a673', '#2c9faf', '#6c757d'],
            hoverBorderColor: "rgba(234, 236, 244, 1)",
        }],
    },
    options: {
        maintainAspectRatio: false,
        responsive: true,
        plugins: {
            legend: {
                position: 'bottom'
            }
        }
    }
});
</script>

<style>
    /* Employee Dashboard - Color Hunt Theme */
    .card {
        background: #ffffff !important;
        border: 1px solid #BCCCDC !important;
        border-radius: 10px;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
    }

    .card-header {
        background: linear-gradient(135deg, #F8FAFC 0%, #D9EAFD 100%) !important;
        border-bottom: 1px solid #BCCCDC !important;
        color: #000000 !important;
    }

    .card-body {
        background: #ffffff !important;
        color: #000000 !important;
    }

    /* KPI Cards with Color Hunt Theme - Different colors for each */
    .border-left-primary {
        border-left: 0.25rem solid #9AA6B2 !important;
    }

    .border-left-success {
        border-left: 0.25rem solid #BCCCDC !important;
    }

    .border-left-info {
        border-left: 0.25rem solid #D9EAFD !important;
    }

    .border-left-warning {
        border-left: 0.25rem solid #9AA6B2 !important;
    }

    /* KPI Icons - Better styling with background containers */
    .card .col-auto > div {
        transition: all 0.3s ease;
    }

    .card:hover .col-auto > div {
        transform: scale(1.05);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .card .col-auto i {
        transition: all 0.3s ease;
    }

    /* Dark Header Styles for Actions Rapides */
    .dark-header {
        background: linear-gradient(135deg, #F8FAFC 0%, #D9EAFD 100%) !important;
        border-bottom: 1px solid #BCCCDC !important;
        color: #000000 !important;
    }

    .dark-header h6 {
        color: #000000 !important;
    }

    .dark-header i {
        color: #5a6672 !important;
    }
    
    /* Ensure all text on light backgrounds is black */
    .card-header:not(.dark-header),
    .card-body,
    .card-title,
    .card-text,
    .table,
    .table th,
    .table td,
    body {
        color: #000000 !important;
    }

    /* Button colors - Use theme colors but keep distinct */
    .btn-primary {
        background: linear-gradient(135deg, #9AA6B2 0%, #7a8692 100%);
        border-color: #9AA6B2;
        color: #ffffff;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #7a8692 0%, #6a7682 100%);
        border-color: #7a8692;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
    }

    .btn-success {
        background: linear-gradient(135deg, #9AA6B2 0%, #7a8692 100%);
        border-color: #9AA6B2;
        color: #ffffff;
        transition: all 0.3s ease;
    }

    .btn-success:hover {
        background: linear-gradient(135deg, #7a8692 0%, #6a7682 100%);
        border-color: #7a8692;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
    }

    .btn-info {
        background: linear-gradient(135deg, #9AA6B2 0%, #7a8692 100%);
        border-color: #9AA6B2;
        color: #ffffff;
        transition: all 0.3s ease;
    }

    .btn-info:hover {
        background: linear-gradient(135deg, #7a8692 0%, #6a7682 100%);
        border-color: #7a8692;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
    }

    .btn-secondary {
        background: linear-gradient(135deg, #9AA6B2 0%, #7a8692 100%);
        border-color: #9AA6B2;
        color: #ffffff;
        transition: all 0.3s ease;
    }

    .btn-secondary:hover {
        background: linear-gradient(135deg, #7a8692 0%, #6a7682 100%);
        border-color: #7a8692;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
    }

    .btn-danger {
        background: linear-gradient(135deg, #9AA6B2 0%, #7a8692 100%);
        border-color: #9AA6B2;
        color: #ffffff;
        transition: all 0.3s ease;
    }

    .btn-danger:hover {
        background: linear-gradient(135deg, #7a8692 0%, #6a7682 100%);
        border-color: #7a8692;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
    }

    /* Text colors - Use theme colors */
    .text-primary {
        color: #5a6672 !important;
    }

    .text-success {
        color: #5a6672 !important;
    }

    .text-info {
        color: #5a6672 !important;
    }

    .text-warning {
        color: #5a6672 !important;
    }

    .text-gray-300 {
        color: #BCCCDC !important;
    }

    /* Badge colors */
    .badge.bg-success {
        background: linear-gradient(135deg, #9AA6B2 0%, #7a8692 100%) !important;
        color: #ffffff;
    }

    /* KPI Card hover effect */
    .card:hover {
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        transform: translateY(-2px);
        transition: all 0.3s ease;
    }

    /* Chart container styling */
    .chart-pie canvas {
        max-height: 100%;
    }

    /* Quick Action Links - Minimalist Icon Design */
    .quick-action-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: #495057;
        padding: 0.5rem;
        border-radius: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .quick-action-link:hover {
        color: #5a6672;
        text-decoration: none;
        transform: translateY(-3px);
    }

    .quick-action-icon-wrapper {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #BCCCDC;
        border-radius: 14px;
        background: #ffffff;
        margin-bottom: 0.5rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .quick-action-icon-wrapper::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, #F8FAFC 0%, #D9EAFD 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .quick-action-icon-wrapper i {
        font-size: 1.5rem;
        color: #5a6672;
        position: relative;
        z-index: 1;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .quick-action-link:hover .quick-action-icon-wrapper {
        border-color: #9AA6B2;
        box-shadow: 0 4px 12px rgba(154, 166, 178, 0.2);
        transform: scale(1.05);
    }

    .quick-action-link:hover .quick-action-icon-wrapper::before {
        opacity: 1;
    }

    .quick-action-link:hover .quick-action-icon-wrapper i {
        color: #5a6672;
        transform: scale(1.1);
    }

    .quick-action-icon-primary {
        border-color: #9AA6B2;
        border-width: 2.5px;
    }

    .quick-action-icon-primary i {
        color: #9AA6B2;
    }

    .quick-action-link:hover .quick-action-icon-primary {
        border-color: #7a8692;
        box-shadow: 0 4px 16px rgba(154, 166, 178, 0.3);
    }

    .quick-action-label {
        font-size: 0.75rem;
        font-weight: 500;
        color: #495057;
        text-align: center;
        transition: color 0.3s ease;
        line-height: 1.2;
    }

    .quick-action-link:hover .quick-action-label {
        color: #5a6672;
        font-weight: 600;
    }
    
    /* ===== MOBILE RESPONSIVE STYLES ===== */
    @media (max-width: 767px) {
        h1.h3 {
            font-size: 1.1rem !important;
        }
        
        .d-sm-flex {
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .col-xl-3,
        .col-md-6 {
            margin-bottom: 0.75rem;
        }
        
        .card-body .h5 {
            font-size: 1.25rem !important;
        }
        
        .text-xs {
            font-size: 0.65rem !important;
        }
        
        .fa-2x {
            font-size: 1.3rem !important;
        }
        
        .table {
            font-size: 0.8rem;
        }
        
        .table th,
        .table td {
            padding: 0.4rem 0.5rem !important;
        }
        
        .badge {
            font-size: 0.7rem !important;
        }
        
        .btn {
            font-size: 0.8rem !important;
            padding: 0.3rem 0.6rem !important;
        }
        
        .btn-sm {
            font-size: 0.7rem !important;
            padding: 0.25rem 0.5rem !important;
        }
        
        .card-header h6 {
            font-size: 0.85rem !important;
        }
        
        .chart-pie {
            height: 10rem !important;
        }
    }
</style>
{% endblock %}