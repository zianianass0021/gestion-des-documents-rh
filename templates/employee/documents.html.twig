{% extends 'base.html.twig' %}

{% block title %}Mes Documents{% endblock %}

{% block body %}
<div class="row g-0">
    <div class="col-12">
        <div class="card compact-page">
            <div class="card-header compact-header py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h4 class="mb-0">
                        <i class="fas fa-file-alt me-1"></i>Mes Documents
                    </h4>
                    <form method="GET" class="d-flex gap-1 compact-search">
                        <div class="input-group input-group-xs">
                            <span class="input-group-text py-0 px-2">
                                <i class="fas fa-search" style="font-size: 0.7rem;"></i>
                            </span>
                            <input type="text" 
                                   class="form-control form-control-xs py-0" 
                                   name="search" 
                                   value="{{ search }}" 
                                   placeholder="Rechercher...">
                        </div>
                        <button type="submit" class="btn btn-primary btn-xs py-0">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                </div>
            </div>
            
            <div class="card-body compact-body p-2">
                {% if search %}
                    <div class="alert alert-info alert-xs py-1 px-2 mb-2 d-flex align-items-center justify-content-between">
                        <small class="mb-0">
                            <i class="fas fa-search me-1"></i>
                            "<strong>{{ search }}</strong>" ({{ documents|length }})
                        </small>
                        <a href="{{ path('employee_documents') }}" class="btn btn-xs btn-outline-primary py-0">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>
                {% endif %}
                
                {% if documents is empty %}
                    <div class="alert alert-info alert-xs py-2 px-3 text-center mb-0">
                        <small><i class="fas fa-info-circle me-1"></i>Aucun document trouvé.</small>
                    </div>
                {% else %}
                    <div class="table-responsive compact-table">
                        <table class="table table-sm table-hover table-striped mb-0 compact-table-inner">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 80px; padding: 0.25rem;">Réf</th>
                                    <th style="width: 200px; padding: 0.25rem;">Nom du Fichier</th>
                                    <th style="width: 100px; padding: 0.25rem;">Type</th>
                                    <th style="width: 120px; padding: 0.25rem;">Dossier</th>
                                    <th style="width: 90px; padding: 0.25rem;">Date</th>
                                    <th style="width: 80px; padding: 0.25rem;">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for document in documents %}
                                <tr>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ document.abbreviation }}</td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ document.libelleComplet|slice(0, 30) }}{% if document.libelleComplet|length > 30 %}...{% endif %}</td>
                                    <td style="padding: 0.25rem;">
                                        <span class="badge bg-secondary" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">{{ document.typeDocument|slice(0, 12) }}</span>
                                    </td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">{{ document.usage|slice(0, 15) }}{% if document.usage|length > 15 %}...{% endif %}</td>
                                    <td style="padding: 0.25rem; font-size: 0.875rem;">
                                        {% if document.uploadedAt %}
                                            {{ document.uploadedAt|date('d/m/Y') }}
                                        {% else %}
                                            <span class="text-muted" style="font-size: 0.75rem;">-</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 0.25rem;">
                                        <span class="badge bg-success" style="font-size: 0.7rem; padding: 0.2rem 0.4rem;">
                                            <i class="fas fa-eye"></i>
                                        </span>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<style>
    .compact-page {
        margin-bottom: 0;
    }
    
    .compact-header {
        padding: 0.5rem 0.75rem !important;
        background-color: #f8fafc;
        border-bottom: 1px solid #bcccdc;
    }
    
    .compact-header h4 {
        font-size: 1.1rem;
        font-weight: 600;
    }
    
    .compact-body {
        padding: 0.5rem !important;
        max-height: calc(100vh - 280px);
        overflow-y: auto;
    }
    
    .compact-table {
        margin: 0;
    }
    
    .compact-table-inner {
        margin-bottom: 0;
        font-size: 0.875rem;
    }
    
    .compact-table-inner th,
    .compact-table-inner td {
        font-size: 0.8rem;
        vertical-align: middle;
    }
    
    .compact-table-inner thead th {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        background-color: #f8f9fa;
    }
    
    .btn-xs {
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 0.2rem;
    }
    
    .input-group-xs {
        height: 24px;
    }
    
    .input-group-xs .form-control,
    .input-group-xs .input-group-text {
        height: 24px;
        padding: 0.1rem 0.3rem;
        font-size: 0.75rem;
    }
    
    .form-control-xs {
        height: 24px;
        padding: 0.1rem 0.3rem;
        font-size: 0.75rem;
    }
    
    .alert-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        margin-bottom: 0.5rem;
    }
    
    .compact-search {
        min-width: 200px;
    }
    
    @media (max-width: 767px) {
        .compact-header .d-flex {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 0.5rem;
        }
        
        .compact-search {
            width: 100%;
            min-width: 100%;
        }
        
        .compact-body {
            max-height: calc(100vh - 350px);
        }
    }
</style>
{% endblock %}
