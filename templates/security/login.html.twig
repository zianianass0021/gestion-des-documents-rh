{% extends 'base_minimal.html.twig' %}

{% block title %}Connexion - Système RH{% endblock %}
{% block description %}Connectez-vous à votre espace personnel du système de gestion des ressources humaines.{% endblock %}

{% block body %}
<!-- Page Transition Styles -->
<style>
    @keyframes pageFadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes pageFadeOut {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(-10px);
        }
    }

    body {
        animation: pageFadeIn 0.2s ease-out;
    }
</style>

<!-- Force light mode for login page -->
<script>
    document.documentElement.setAttribute('data-bs-theme', 'light');
    localStorage.setItem('theme', 'light');
</script>

<!-- Page Transition Script -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Removed transition delays for faster navigation
    });
</script>

{% if app.user %}
<script>
    // Instant redirect if already logged in
    window.location.href = '{{ path('app_dashboard') }}';
</script>
{% endif %}

<div class="login-page-wrapper">
    <div class="login-container">
        <!-- Left Side - Login Form -->
        <div class="login-left">
            <div class="login-content">
                <!-- Logo -->
                <div class="login-logo-section">
                    <div class="logo-circle">
                        <img src="{{ asset('logo.png') }}?v={{ 'now'|date('U') }}" alt="Système RH" class="logo-img">
        </div>
    </div>

                <!-- Title -->
                <h1 class="login-main-title">Connexion</h1>
                <p class="login-subtitle-text">Accédez à votre espace personnel</p>

                <!-- Login Form -->
                <form method="post" action="{{ path('app_login') }}" class="login-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        {% if error %}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endif %}

                            <!-- Username Field -->
                    <div class="form-field">
                        <label for="inputUsername" class="form-label">
                            <i class="fas fa-user me-2"></i>Nom d'utilisateur
                                </label>
                                <input 
                                    type="text" 
                                    value="{{ last_username }}" 
                                    name="username" 
                                    id="inputUsername" 
                            class="form-input" 
                            placeholder="Nom d'utilisateur"
                                    required 
                                    autofocus
                                    autocomplete="username"
                                >
                            </div>

                            <!-- Password Field -->
                    <div class="form-field">
                        <label for="inputPassword" class="form-label">
                            <i class="fas fa-lock me-2"></i>Mot de passe
                                </label>
                        <div class="password-wrapper">
                                    <input 
                                        type="password" 
                                        name="password" 
                                        id="inputPassword" 
                                class="form-input" 
                                placeholder="Mot de passe"
                                        required
                                        autocomplete="current-password"
                                    >
                            <button type="button" class="password-toggle" id="passwordToggle">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Remember Me -->
                    <div class="form-checkbox">
                        <input class="checkbox-input" type="checkbox" name="_remember_me" id="rememberMe">
                        <label class="checkbox-label" for="rememberMe">Se souvenir de moi</label>
                            </div>

                    <!-- Submit Button -->
                    <button class="login-button" type="submit" id="loginBtn">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        Se connecter
                    </button>
                        </form>

                <!-- Footer -->
                <div class="login-footer">
                    <span class="footer-text">
                                <i class="fas fa-shield-alt me-1"></i>
                                Connexion sécurisée
                    </span>
                    <a href="{{ path('app_home') }}" class="home-link" id="backToHome">
                        <i class="fas fa-arrow-left me-1"></i>
                        Accueil
                    </a>
                </div>
                        </div>
                    </div>

        <!-- Right Side - Illustration -->
        <div class="login-right">
            <div class="illustration-container">
                <!-- Animated Documents -->
                <div class="docs-animation">
                    <div class="doc doc-1"></div>
                    <div class="doc doc-2"></div>
                    <div class="doc doc-3"></div>
                </div>

                <!-- Floating Icons -->
                <div class="icon-1"><i class="fas fa-file-alt"></i></div>
                <div class="icon-2"><i class="fas fa-users"></i></div>
                <div class="icon-3"><i class="fas fa-folder-open"></i></div>
                <div class="icon-4"><i class="fas fa-check-circle"></i></div>

                <!-- Text -->
                <div class="illustration-text">
                    <h2 class="ill-title">Avec UDOC</h2>
                    <p class="ill-subtitle">Simplifiez la gestion de vos documents et ressources humaines en toute simplicité</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    * {
        box-sizing: border-box;
    }

    .login-page-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background: #ffffff;
    }

    .login-container {
        display: flex;
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

    /* Left Side */
    .login-left {
        flex: 0 0 50%;
        width: 50%;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        overflow: hidden;
    }

    .login-content {
        width: 100%;
        max-width: 420px;
        max-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-logo-section {
        text-align: center;
        margin-bottom: 1rem;
    }

    .logo-circle {
        width: 65px;
        height: 65px;
        background: #ffffff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .logo-img {
        width: 45px;
        height: 45px;
        object-fit: contain;
    }

    .login-main-title {
        font-size: 2rem;
        font-weight: 700;
        color: #000000;
        margin-bottom: 0.25rem;
        text-align: center;
    }

    .login-subtitle-text {
        font-size: 0.9rem;
        color: #6a7682;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .form-field {
        margin-bottom: 1rem;
    }

    .form-label {
        display: block;
        color: #000000;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .form-label i {
        color: #9aa6b2;
    }

    .form-input {
        width: 100%;
        padding: 0.65rem 0.9rem;
        font-size: 0.9rem;
        border: 2px solid #bcccdc;
        border-radius: 1rem;
        background: #ffffff;
        color: #000000;
        transition: all 0.3s ease;
    }

    .form-input:focus {
        outline: none;
        border-color: #9aa6b2;
        box-shadow: 0 0 0 4px rgba(154, 166, 178, 0.15);
    }

    .password-wrapper {
        position: relative;
    }

    .password-toggle {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(154, 166, 178, 0.1);
        border: none;
        color: #000000;
        cursor: pointer;
        padding: 0.4rem;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .password-toggle:hover {
        background: rgba(154, 166, 178, 0.2);
    }

    .form-checkbox {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
    }

    .checkbox-input {
        width: 18px;
        height: 18px;
        margin-right: 0.5rem;
        cursor: pointer;
    }

    .checkbox-label {
        color: #000000;
        font-size: 0.9rem;
        cursor: pointer;
    }

    .login-button {
        width: 100%;
        padding: 0.65rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: #ffffff;
        background: linear-gradient(135deg, #5a6672 0%, #4a5662 100%);
        border: none;
        border-radius: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 6px 20px rgba(90, 102, 114, 0.35);
    }

    .login-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(90, 102, 114, 0.45);
        background: linear-gradient(135deg, #4a5662 0%, #3a4652 100%);
    }

    .login-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #e2e8f0;
    }

    .footer-text {
        color: #6a7682;
        font-size: 0.85rem;
    }

    .home-link {
        color: #5a6672;
        text-decoration: none;
        font-size: 0.85rem;
        padding: 0.5rem 1rem;
        border: 1px solid #bcccdc;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .home-link:hover {
        background: #e2e8f0;
        color: #4a5662;
        text-decoration: none;
    }

    .alert {
        padding: 0.75rem 1rem;
        border-radius: 0.75rem;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
    }

    /* Right Side */
    .login-right {
        flex: 0 0 50%;
        width: 50%;
        background: linear-gradient(135deg, #5a6672 0%, #4a5662 50%, #3a4652 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        position: relative;
        overflow: hidden;
    }


    .illustration-container {
        width: 100%;
        max-width: 500px;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    /* Animated Documents */
    .docs-animation {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 200px;
        height: 250px;
        margin: 0;
        z-index: 10;
    }

    .doc {
        position: absolute;
        width: 180px;
        height: 220px;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        padding: 20px;
        animation: docFloat 3s ease-in-out infinite;
    }

    .doc::before {
        content: '';
        display: block;
        width: 100%;
        height: 8px;
        background: #9aa6b2;
        border-radius: 4px;
        margin-bottom: 12px;
    }

    .doc::after {
        content: '';
        display: block;
        width: 60%;
        height: 8px;
        background: #9aa6b2;
        border-radius: 4px;
        margin-top: 12px;
    }

    .doc-1 {
        z-index: 3;
        transform: rotate(-5deg);
        animation-delay: 0s;
    }

    .doc-2 {
        z-index: 2;
        transform: rotate(2deg) translate(10px, 10px);
        background: rgba(255, 255, 255, 0.95);
        animation-delay: 0.2s;
    }

    .doc-3 {
        z-index: 1;
        transform: rotate(-3deg) translate(20px, 20px);
        background: rgba(255, 255, 255, 0.9);
        animation-delay: 0.4s;
    }

    @keyframes docFloat {
        0%, 100% { transform: translateY(0px) rotate(var(--rot, 0deg)); }
        50% { transform: translateY(-15px) rotate(var(--rot, 0deg)); }
    }

    .doc-1 { --rot: -5deg; }
    .doc-2 { --rot: 2deg; }
    .doc-3 { --rot: -3deg; }

    /* Floating Icons */
    .icon-1, .icon-2, .icon-3, .icon-4 {
        position: absolute;
            width: 60px;
            height: 60px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid rgba(255, 255, 255, 0.3);
        animation: iconFloat 4s ease-in-out infinite;
    }

    .icon-1 i, .icon-2 i, .icon-3 i, .icon-4 i {
        font-size: 24px;
        color: #ffffff;
    }

    .icon-1 {
        top: 50%;
        left: 50%;
        transform: translate(-180px, -230px);
        animation-delay: 0s;
    }

    .icon-2 {
        top: 50%;
        left: 50%;
        transform: translate(120px, -230px);
        animation-delay: 1s;
    }

    .icon-3 {
        top: 50%;
        left: 50%;
        transform: translate(-180px, 100px);
        animation-delay: 2s;
    }

    .icon-4 {
        top: 50%;
        left: 50%;
        transform: translate(120px, 100px);
        animation-delay: 1.5s;
    }

    @keyframes iconFloat {
        0%, 100% { 
            transform: translate(var(--tx, 0), var(--ty, 0)) translateY(0px) scale(1);
            opacity: 0.8;
        }
        50% { 
            transform: translate(var(--tx, 0), var(--ty, 0)) translateY(-15px) scale(1.1);
            opacity: 1;
        }
    }
    
    .icon-1 { --tx: -180px; --ty: -230px; }
    .icon-2 { --tx: 120px; --ty: -230px; }
    .icon-3 { --tx: -180px; --ty: 100px; }
    .icon-4 { --tx: 120px; --ty: 100px; }

    /* Text */
    .login-right .illustration-text {
        text-align: center;
        margin-top: auto;
        padding-top: 2rem;
        position: relative;
        z-index: 5;
        width: 100%;
    }

    /* Override base template's global h2 and p color rules */
    .login-right .illustration-text h2.ill-title,
    .login-right .illustration-text .ill-title,
    .login-page-wrapper .login-right h2.ill-title {
        color: #e3e5e7 !important;
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
        letter-spacing: 0.5px;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    }

    .login-right .illustration-text p.ill-subtitle,
    .login-right .illustration-text .ill-subtitle,
    .login-page-wrapper .login-right p.ill-subtitle {
        color: #e3e5e7 !important;
        font-size: 1.1rem;
        line-height: 1.6;
        font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
        font-weight: 400;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        max-width: 90%;
        margin: 0 auto;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .login-container {
            flex-direction: column;
        }

        .login-left {
            flex: 0 0 100%;
            width: 100%;
            padding: 1.5rem;
        }

        .login-right {
            display: none;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Password toggle
            const passwordToggle = document.getElementById('passwordToggle');
            const passwordInput = document.getElementById('inputPassword');
            
            if (passwordToggle && passwordInput) {
                passwordToggle.addEventListener('click', function(e) {
                    e.preventDefault();
                    const currentType = passwordInput.getAttribute('type');
                    const newType = currentType === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', newType);
                    
                    const icon = this.querySelector('i');
                    if (icon) {
                        if (newType === 'text') {
                            icon.classList.remove('fa-eye');
                            icon.classList.add('fa-eye-slash');
                        } else {
                            icon.classList.remove('fa-eye-slash');
                            icon.classList.add('fa-eye');
                        }
                    }
            });
        }

        // Form submission
        const form = document.querySelector('.login-form');
        if (form) {
            form.addEventListener('submit', function() {
                const loginBtn = document.getElementById('loginBtn');
                if (loginBtn && !loginBtn.disabled) {
                    loginBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Connexion...';
                    loginBtn.disabled = true;
                }
            });
        }

        // Back to home
        const backToHomeBtn = document.getElementById('backToHome');
        if (backToHomeBtn) {
            backToHomeBtn.addEventListener('click', function(e) {
                e.preventDefault();
                window.location.href = '{{ path('app_home') }}';
            });
        }

        // Debug
        console.log('Login page loaded');
        console.log('Right side display:', window.getComputedStyle(document.querySelector('.login-right')).display);
        console.log('Viewport width:', window.innerWidth);
    });
</script>
{% endblock %}
