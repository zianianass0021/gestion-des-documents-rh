{% extends 'base.html.twig' %}

{% block title %}Ajouter un Responsable RH{% endblock %}

{% block body %}
<div class="form-page-container">
    <div class="form-wrapper">
        <div class="modern-form-card">
            <!-- Header -->
            <div class="form-header">
                <div class="header-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <div class="header-content">
                    <h2 class="form-title">Ajouter un Responsable RH</h2>
                    <p class="form-subtitle">Créez un nouveau compte responsable RH et configurez ses permissions</p>
                </div>
            </div>

            <!-- Form Body -->
            <div class="form-body">
                {{ form_start(form, {'attr': {'class': 'modern-form'}}) }}
                
                <!-- Informations Personnelles Section -->
                <div class="form-section">
                    <div class="section-header">
                        <i class="fas fa-user-circle section-icon"></i>
                        <h3 class="section-title">Informations Personnelles</h3>
                    </div>
                    <div class="section-content">
                        <div class="row g-2">
    <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="fas fa-user label-icon"></i>
                        {{ form_label(form.prenom) }}
                                    </label>
                                    {{ form_widget(form.prenom, {'attr': {'class': 'form-control-modern', 'placeholder': 'Entrez le prénom'}}) }}
                        {{ form_errors(form.prenom) }}
                                </div>
                    </div>
                    
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="fas fa-user label-icon"></i>
                        {{ form_label(form.nom) }}
                                    </label>
                                    {{ form_widget(form.nom, {'attr': {'class': 'form-control-modern', 'placeholder': 'Entrez le nom'}}) }}
                        {{ form_errors(form.nom) }}
                                </div>
                    </div>
                    
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="fas fa-envelope label-icon"></i>
                        {{ form_label(form.email) }}
                                    </label>
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control-modern', 'placeholder': 'exemple@uiass.rh'}}) }}
                        {{ form_errors(form.email) }}
                                </div>
                    </div>
                    
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="fas fa-user-circle label-icon"></i>
                        {{ form_label(form.username) }}
                                    </label>
                                    {{ form_widget(form.username, {'attr': {'class': 'form-control-modern', 'placeholder': 'nom.utilisateur'}}) }}
                        {{ form_errors(form.username) }}
                                </div>
                    </div>
                    
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="fas fa-phone label-icon"></i>
                        {{ form_label(form.telephone) }}
                                    </label>
                                    {{ form_widget(form.telephone, {'attr': {'class': 'form-control-modern', 'placeholder': '+212 6XX XXX XXX'}}) }}
                        {{ form_errors(form.telephone) }}
                                </div>
                    </div>
                    
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="fas fa-lock label-icon"></i>
                        {{ form_label(form.password) }}
                                    </label>
                                    {{ form_widget(form.password, {'attr': {'class': 'form-control-modern', 'placeholder': '••••••••'}}) }}
                        {{ form_errors(form.password) }}
                                </div>
                            </div>
                        </div>
                    </div>
                    </div>
                    
                <!-- Modules Section -->
                <div class="form-section">
                    <div class="section-header">
                        <i class="fas fa-puzzle-piece section-icon"></i>
                        <h3 class="section-title">Modules Autorisés</h3>
                    </div>
                    <div class="section-content">
                        <div class="modules-selection-area">
                            <button type="button" class="btn-select-modules" data-bs-toggle="modal" data-bs-target="#modulesModal">
                                <i class="fas fa-plus-circle me-2"></i>
                                Sélectionner les modules
                        </button>
                            <div id="selectedModulesDisplay" class="selected-modules-display">
                                <span class="no-modules-text">Aucun module sélectionné</span>
                            </div>
                        </div>
                        {{ form_errors(form.modules) }}
                    </div>
                    </div>

                <!-- Permissions Organisationnelles Section -->
                <div class="form-section">
                    <div class="section-header">
                        <i class="fas fa-sitemap section-icon"></i>
                        <h3 class="section-title">Permissions Organisationnelles</h3>
                    </div>
                    <div class="section-content">
                        <div class="modules-selection-area">
                            <button type="button" class="btn-select-modules" data-bs-toggle="modal" data-bs-target="#orgPermissionsModal">
                                <i class="fas fa-network-wired me-2"></i>
                                Configurer les permissions organisationnelles
                            </button>
                            <div id="selectedOrgPermissionsDisplay" class="selected-modules-display">
                                <span class="no-modules-text">Aucune restriction (accès à toutes les organisations)</span>
                            </div>
                        </div>
                        <div style="display: none;">
                            {{ form_widget(form.organisation_permissions) }}
                        </div>
                        {{ form_errors(form.organisation_permissions) }}
                    </div>
                </div>
                    
                <!-- Form Actions -->
                <div class="form-actions">
                    <a href="{{ path('admin_manage_responsables') }}" class="btn btn-action-secondary">
                        <i class="fas fa-arrow-left me-2"></i>
                        Retour
                    </a>
                    <button type="submit" class="btn btn-action-primary">
                        <i class="fas fa-save me-2"></i>
                        Enregistrer
                    </button>
                </div>
                
                <!-- Hidden modules field - will be populated by JavaScript from modal checkboxes -->
                <div style="display: none !important;">
                    {% for child in form.modules %}
                        <input type="checkbox" 
                               name="{{ child.vars.full_name }}" 
                               value="{{ child.vars.value }}" 
                               id="hidden_module_{{ child.vars.value }}"
                               {% if child.vars.checked %}checked="checked"{% endif %}>
                    {% endfor %}
                </div>
                
                <!-- Modules Selection Modal -->
                <div class="modal fade" id="modulesModal" tabindex="-1" aria-labelledby="modulesModalLabel" aria-hidden="true" data-bs-backdrop="static">
                    <div class="modal-dialog modal-xl modal-dialog-centered">
                        <div class="modal-content modules-modal-content">
                            <div class="modal-header modules-modal-header">
                                <div class="modal-header-content">
                                    <div class="modal-icon-wrapper">
                                        <i class="fas fa-puzzle-piece"></i>
                                    </div>
                                    <div>
                                        <h5 class="modal-title" id="modulesModalLabel">Sélectionner les Modules</h5>
                                        <p class="modal-subtitle">Choisissez les modules auxquels ce responsable RH aura accès</p>
                                    </div>
                                </div>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body modules-modal-body">
                                <div class="modules-grid-new">
                                    {% for child in form.modules %}
                                        {% set moduleId = child.vars.value %}
                                        {% set module = modulesMap[moduleId] %}
                                        <div class="module-item-new" data-module-id="{{ moduleId }}">
                                            <label class="module-item-label">
                                                <input type="checkbox" 
                                                       name="{{ child.vars.full_name }}" 
                                                       value="{{ child.vars.value }}" 
                                                       id="modal_module_{{ moduleId }}"
                                                       {% if child.vars.checked %}checked="checked"{% endif %}
                                                       class="module-checkbox-input" 
                                                       data-module-id="{{ moduleId }}">
                                                <div class="module-item-card">
                                                    <div class="module-item-checkbox">
                                                        <i class="fas fa-check"></i>
                                                    </div>
                                                    <div class="module-item-icon">
                                                        {% if module and module.icon %}
                                                            <i class="{{ module.icon }}"></i>
                                                        {% else %}
                                                            <i class="fas fa-cube"></i>
                                                        {% endif %}
                                                    </div>
                                                    <div class="module-item-content">
                                                        <h6 class="module-item-title">{{ child.vars.label }}</h6>
                                                        {% if module and module.description %}
                                                            <p class="module-item-desc">{{ module.description }}</p>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            <div class="modal-footer modules-modal-footer">
                                <button type="button" class="btn btn-modal-cancel" data-bs-dismiss="modal">
                                    <i class="fas fa-times me-2"></i>Annuler
                                </button>
                                <button type="button" class="btn btn-modal-confirm" id="confirmModulesSelection">
                                    <i class="fas fa-check me-2"></i>Confirmer la sélection
                        </button>
                    </div>
                        </div>
                    </div>
                </div>
                
                <!-- Organisation Permissions Selection Modal -->
                <div class="modal fade" id="orgPermissionsModal" tabindex="-1" aria-labelledby="orgPermissionsModalLabel" aria-hidden="true" data-bs-backdrop="static">
                    <div class="modal-dialog modal-xl modal-dialog-centered">
                        <div class="modal-content modules-modal-content">
                            <div class="modal-header modules-modal-header">
                                <div class="modal-header-content">
                                    <div class="modal-icon-wrapper">
                                        <i class="fas fa-sitemap"></i>
                                    </div>
                                    <div>
                                        <h5 class="modal-title" id="orgPermissionsModalLabel">Configurer les Permissions Organisationnelles</h5>
                                        <p class="modal-subtitle">Sélectionnez les organisations que ce responsable RH pourra gérer</p>
                                    </div>
                                </div>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body modules-modal-body" style="max-height: 70vh; overflow-y: auto;">
                                <div id="orgPermissionsTree" class="org-permissions-tree">
                                    {% if orgHierarchy is defined and orgHierarchy %}
                                        {% for groupement, dasList in orgHierarchy %}
                                            <div class="org-permission-group" data-groupement="{{ groupement }}">
                                                <div class="org-permission-group-header">
                                                    <button type="button" class="btn-collapse" data-bs-toggle="collapse" data-bs-target="#collapse-groupement-{{ groupement }}">
                                                        <i class="fas fa-chevron-down"></i>
                                                    </button>
                                                    <label class="org-permission-label">
                                                        <input type="checkbox" class="org-checkbox org-groupement-checkbox" 
                                                               data-groupement="{{ groupement }}" 
                                                               data-type="groupement">
                                                        <span class="org-permission-title">
                                                            <i class="fas fa-folder me-2"></i>
                                                            {{ groupementLabels[groupement] ?? groupement }}
                                                        </span>
                                                    </label>
                                                </div>
                                                <div class="collapse" id="collapse-groupement-{{ groupement }}">
                                                    <div class="org-permission-children">
                                                        {% if dasList %}
                                                            {% for das, dossiers in dasList %}
                                                                <div class="org-permission-das" data-das="{{ das }}" data-groupement="{{ groupement }}">
                                                                    <div class="org-permission-das-header">
                                                                        <button type="button" class="btn-collapse" data-bs-toggle="collapse" data-bs-target="#collapse-das-{{ groupement }}-{{ das }}">
                                                                            <i class="fas fa-chevron-down"></i>
                                                                        </button>
                                                                        <label class="org-permission-label">
                                                                            <input type="checkbox" class="org-checkbox org-das-checkbox" 
                                                                                   data-das="{{ das }}" 
                                                                                   data-groupement="{{ groupement }}" 
                                                                                   data-type="das">
                                                                            <span class="org-permission-title">
                                                                                <i class="fas fa-folder-open me-2"></i>
                                                                                {{ dasLabels[das] ?? das }}
                                                                            </span>
                                                                        </label>
                                                                    </div>
                                                                    <div class="collapse" id="collapse-das-{{ groupement }}-{{ das }}">
                                                                        <div class="org-permission-dossiers">
                                                                            {% if dossiers %}
                                                                                {% for dossier in dossiers %}
                                                                                    <div class="org-permission-dossier" data-dossier="{{ dossier }}" data-das="{{ das }}" data-groupement="{{ groupement }}">
                                                                                        <label class="org-permission-label">
                                                                                            <input type="checkbox" class="org-checkbox org-dossier-checkbox" 
                                                                                                   data-dossier="{{ dossier }}" 
                                                                                                   data-das="{{ das }}" 
                                                                                                   data-groupement="{{ groupement }}" 
                                                                                                   data-type="dossier">
                                                                                            <span class="org-permission-title">
                                                                                                <i class="fas fa-file me-2"></i>
                                                                                                {{ dossier }}
                                                                                            </span>
                                                                                        </label>
                                                                                    </div>
                                                                                {% endfor %}
                                                                            {% endif %}
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            {% endfor %}
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <p class="text-center text-muted">Aucune hiérarchie organisationnelle disponible</p>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="modal-footer modules-modal-footer">
                                <button type="button" class="btn btn-modal-cancel" data-bs-dismiss="modal">
                                    <i class="fas fa-times me-2"></i>Annuler
                                </button>
                                <button type="button" class="btn btn-modal-confirm" id="confirmOrgPermissionsSelection">
                                    <i class="fas fa-check me-2"></i>Confirmer la sélection
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                {{ form_end(form, {'render_rest': false}) }}
            </div>
        </div>
    </div>
</div>

<style>
    /* Prevent all scrolling - AGGRESSIVE */
    html, body {
        overflow: hidden !important;
        height: 100% !important;
        max-height: 100vh !important;
        position: fixed !important;
        width: 100% !important;
    }
    
    .main-area, .container-fluid {
        overflow: hidden !important;
        height: 100% !important;
        max-height: 100vh !important;
    }
    
    .form-page-container {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, #F8FAFC 0%, #E8F0F8 100%);
        overflow: hidden !important;
        padding: 0.4rem 0.75rem;
        display: flex;
        align-items: stretch;
        justify-content: center;
        height: 100vh !important;
        max-height: 100vh !important;
        width: 100% !important;
    }

    .form-wrapper {
        width: 100%;
        max-width: 1400px;
        height: 100%;
        max-height: 100%;
        display: flex;
        align-items: stretch;
        justify-content: center;
        overflow: hidden !important;
    }

    .modern-form-card {
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden !important;
        width: 100%;
        height: 100%;
        max-height: 100%;
        display: flex;
        flex-direction: column;
        margin: 0 auto;
    }

    .form-header {
        background: linear-gradient(135deg, #9AA6B2 0%, #7a8692 100%);
        padding: 0.3rem 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        color: white;
        flex-shrink: 0;
    }

    .header-icon {
        width: 36px;
        height: 36px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .header-content {
        flex: 1;
    }

    .form-title {
        font-size: 1rem;
        font-weight: 700;
        margin: 0 0 0.05rem 0;
        color: white;
    }

    .form-subtitle {
        font-size: 0.7rem;
        margin: 0;
        opacity: 0.9;
        color: white;
    }

    .form-body {
        padding: 0.3rem 0.5rem;
        flex: 1 1 auto;
        overflow: hidden !important;
        display: flex;
        flex-direction: column;
        min-height: 0;
        max-height: 100%;
        gap: 0.3rem;
    }

    .form-section {
        margin-bottom: 0;
        background: #F8FAFC;
        border-radius: 6px;
        padding: 0.3rem 0.5rem;
        border: 1px solid #E8F0F8;
        flex-shrink: 0;
    }

    .form-section:last-of-type {
        margin-bottom: 0;
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }
    
    .section-header {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        margin-bottom: 0.3rem;
        padding-bottom: 0.2rem;
        border-bottom: 2px solid #D9EAFD;
        flex-shrink: 0;
    }

    .section-icon {
        font-size: 0.95rem;
        color: #9AA6B2;
    }

    .section-title {
        font-size: 0.9rem;
        font-weight: 600;
        margin: 0;
        color: #2a3642;
    }

    .section-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }

    .form-group-modern {
        margin-bottom: 0.3rem;
    }
    
    .form-help-text {
        font-size: 0.7rem;
        margin-top: 0.05rem;
        padding: 0;
    }
    
    .row.g-2 {
        --bs-gutter-y: 0.3rem;
        --bs-gutter-x: 0.3rem;
    }

    .form-label-modern {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-weight: 600;
        font-size: 0.8rem;
        color: #2a3642;
        margin-bottom: 0.2rem;
    }

    .label-icon {
        color: #9AA6B2;
        font-size: 0.8rem;
    }
    
    .form-control-modern {
        width: 100%;
        padding: 0.35rem 0.55rem;
        font-size: 0.8rem;
        border: 2px solid #D9EAFD;
        border-radius: 6px;
        background: white;
        color: #2a3642;
        transition: all 0.3s ease;
        line-height: 1.4;
    }

    .form-control-modern:focus {
        outline: none;
        border-color: #9AA6B2;
        box-shadow: 0 0 0 3px rgba(154, 166, 178, 0.1);
        background: white;
    }

    .form-control-modern::placeholder {
        color: #BCCCDC;
    }

    /* Modules Selection Area */
    .modules-selection-area {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .btn-select-modules {
        padding: 0.4rem 0.9rem;
        background: linear-gradient(135deg, #9AA6B2 0%, #7a8692 100%);
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: fit-content;
    }

    .btn-select-modules:hover {
        background: linear-gradient(135deg, #7a8692 0%, #6a7682 100%);
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(154, 166, 178, 0.3);
        color: white;
    }

    .selected-modules-display {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        min-height: 1.5rem;
        padding: 0.3rem;
        background: white;
        border-radius: 6px;
        border: 2px solid #D9EAFD;
    }

    .no-modules-text {
        color: #BCCCDC;
        font-size: 0.8rem;
        font-style: italic;
    }

    .module-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.6rem;
        background: linear-gradient(135deg, #D9EAFD 0%, #BCCCDC 100%);
        color: #2a3642;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .module-badge i {
        font-size: 0.75rem;
    }

    /* Modal Styles - Rebuilt from scratch */
    .modules-modal-content {
        border-radius: 16px;
        border: none;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        display: flex;
        flex-direction: column;
        max-height: 90vh;
    }

    .modules-modal-header {
        background: linear-gradient(135deg, #9AA6B2 0%, #7a8692 100%);
        color: white;
        border-bottom: none;
        padding: 1rem 1.5rem;
        border-radius: 16px 16px 0 0;
        flex-shrink: 0;
    }

    .modal-header-content {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1;
    }

    .modal-icon-wrapper {
        width: 50px;
        height: 50px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .modal-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: white;
    }

    .modal-subtitle {
        font-size: 0.875rem;
        margin: 0.25rem 0 0 0;
        opacity: 0.9;
        color: white;
    }

    .modules-modal-body {
        padding: 1rem 1.5rem;
        overflow: hidden;
        max-height: none;
        flex: 1;
        min-height: 0;
    }

    .modules-grid-new {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 0.75rem;
    }

    .module-item-new {
        position: relative;
    }

    .module-checkbox-input {
        display: none;
    }

    .module-item-label {
        display: block;
        cursor: pointer;
        margin: 0;
    }
    
    .module-item-card {
        background: white;
        border: 3px solid #D9EAFD;
        border-radius: 12px;
        padding: 1rem;
        transition: all 0.3s ease;
        position: relative;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.5rem;
    }

    .module-item-card:hover {
        border-color: #9AA6B2;
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(154, 166, 178, 0.2);
    }

    .module-item-checkbox {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        width: 28px;
        height: 28px;
        background: #E8F0F8;
        border: 2px solid #BCCCDC;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        opacity: 0;
        transform: scale(0.8);
        pointer-events: none;
    }

    .module-item-checkbox i {
        color: white;
        font-size: 0.875rem;
        font-weight: bold;
    }

    .module-checkbox-input:checked ~ .module-item-card,
    .module-item-card.selected {
        background: linear-gradient(135deg, #E8F0F8 0%, #D9EAFD 100%);
        border-color: #9AA6B2;
        border-width: 3px;
    }

    .module-checkbox-input:checked ~ .module-item-card .module-item-checkbox,
    .module-item-card.selected .module-item-checkbox {
        background: #9AA6B2;
        border-color: #9AA6B2;
        opacity: 1;
        transform: scale(1);
    }

    .module-checkbox-input:checked ~ .module-item-card .module-item-icon,
    .module-item-card.selected .module-item-icon {
        background: #9AA6B2;
        color: white;
        transform: scale(1.1);
