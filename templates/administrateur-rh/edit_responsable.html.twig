</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const modulesModal = document.getElementById('modulesModal');
    const confirmBtn = document.getElementById('confirmModulesSelection');
    const selectedModulesDisplay = document.getElementById('selectedModulesDisplay');
    const moduleCheckboxes = document.querySelectorAll('.module-checkbox-input');
    
    // Store modules data
    const modulesData = {};
    {% for child in form.modules %}
        {% set moduleId = child.vars.value %}
        {% set module = modulesMap[moduleId] %}
        modulesData[{{ moduleId }}] = {
            id: {{ moduleId }},
            label: '{{ child.vars.label|e('js') }}',
            icon: '{% if module and module.icon %}{{ module.icon|e('js') }}{% else %}fas fa-cube{% endif %}'
        };
    {% endfor %}
    
    // Add click handlers to checkboxes for visual feedback
    moduleCheckboxes.forEach(function(checkbox) {
        checkbox.addEventListener('change', function() {
            const card = this.closest('.module-item-new').querySelector('.module-item-card');
            if (this.checked) {
                card.classList.add('selected');
            } else {
                card.classList.remove('selected');
            }
        });
    });
    
    // Update display when modal is shown
    modulesModal.addEventListener('show.bs.modal', function() {
        // Sync visual state with checkbox state
        moduleCheckboxes.forEach(function(checkbox) {
            const card = checkbox.closest('.module-item-new').querySelector('.module-item-card');
            if (checkbox.checked) {
                card.classList.add('selected');
            } else {
                card.classList.remove('selected');
            }
        });
        updateSelectedModulesDisplay();
    });
    
    // Confirm selection
    confirmBtn.addEventListener('click', function() {
        const bootstrapModal = bootstrap.Modal.getInstance(modulesModal);
        bootstrapModal.hide();
        updateSelectedModulesDisplay();
    });
    
    // Store current modules from server (passed via form checkboxes state)
    const currentModulesFromServer = [];
    moduleCheckboxes.forEach(function(checkbox) {
        if (checkbox.checked) {
            const moduleId = checkbox.getAttribute('data-module-id');
            currentModulesFromServer.push(parseInt(moduleId));
        }
    });
    
    // Update selected modules display
    function updateSelectedModulesDisplay() {
        const selected = [];
        // Check both modal checkboxes and hidden checkboxes
        const allCheckboxes = document.querySelectorAll('.module-checkbox-input, input[name="responsable_rh[modules][]"]');
        allCheckboxes.forEach(function(checkbox) {
            if (checkbox.checked) {
                const moduleId = checkbox.getAttribute('data-module-id') || checkbox.value;
                const module = modulesData[moduleId];
                if (module) {
                    // Avoid duplicates
                    if (!selected.find(function(m) { return m.id == moduleId; })) {
                        selected.push(module);
                    }
                }
            }
        });
        
        if (selected.length === 0) {
            selectedModulesDisplay.innerHTML = '<span class="no-modules-text">Aucun module sélectionné</span>';
        } else {
            selectedModulesDisplay.innerHTML = selected.map(function(module) {
                return '<span class="module-badge"><i class="' + module.icon + '"></i>' + module.label + '</span>';
            }).join('');
        }
    }
    
    // Initialize display with current selections from server
    // This will show modules even if modal hasn't been opened yet
    setTimeout(function() {
        updateSelectedModulesDisplay();
        if (currentModulesFromServer.length > 0) {
            currentModulesFromServer.forEach(function(moduleId) {
                const module = modulesData[moduleId];
                if (module) {
                    // Ensure checkbox is checked
                    const checkbox = document.querySelector('.module-checkbox-input[data-module-id="' + moduleId + '"]');
                    if (checkbox && !checkbox.checked) {
                        checkbox.checked = true;
                        const card = checkbox.closest('.module-item-new');
                        if (card) {
                            const cardElement = card.querySelector('.module-item-card');
                            if (cardElement) {
                                cardElement.classList.add('selected');
                            }
                        }
                    }
                }
            });
            updateSelectedModulesDisplay();
        }
    }, 100);
    
    // Initialize display with current selections
    updateSelectedModulesDisplay();
    
    // ===== ORGANISATION PERMISSIONS MANAGEMENT =====
    const orgPermissionsModal = document.getElementById('orgPermissionsModal');
    const confirmOrgPermissionsBtn = document.getElementById('confirmOrgPermissionsSelection');
    const selectedOrgPermissionsDisplay = document.getElementById('selectedOrgPermissionsDisplay');
    let orgPermissionsInput = document.getElementById('organisation_permissions_input');
    
    // CRITICAL: If input not found, try to find it by name
    if (!orgPermissionsInput) {
        orgPermissionsInput = document.querySelector('input[name="responsable_rh[organisation_permissions]"]');
        console.log('Input not found by ID, trying by name...', !!orgPermissionsInput);
    }
    
    // Check if elements exist and are valid Nodes
    const isElementValid = function(element) {
        return element && element instanceof Node && element.parentNode;
    };
    
    if (!orgPermissionsInput) {
        console.error('✗✗✗ CRITICAL: organisation_permissions input NOT FOUND! ✗✗✗');
        console.error('Tried by ID: organisation_permissions_input');
        console.error('Tried by name: responsable_rh[organisation_permissions]');
        // Try to find all inputs in the form
        const form = document.querySelector('.modern-form');
        if (form) {
            const allInputs = form.querySelectorAll('input[type="text"], input[type="hidden"]');
            console.error('All inputs in form:', Array.from(allInputs).map(i => ({name: i.name, id: i.id, value: i.value.substring(0, 50)})));
        }
    }
    
    if (!orgPermissionsModal || !confirmOrgPermissionsBtn || !isElementValid(selectedOrgPermissionsDisplay)) {
        console.error('Organisation permissions modal elements not found or invalid:', {
            modal: !!orgPermissionsModal,
            btn: !!confirmOrgPermissionsBtn,
            display: !!selectedOrgPermissionsDisplay && selectedOrgPermissionsDisplay instanceof Node,
            displayInDOM: isElementValid(selectedOrgPermissionsDisplay),
            input: !!orgPermissionsInput
        });
    } else {
        // Organisation hierarchy data
        const orgHierarchy = {{ orgHierarchy|default({})|json_encode|raw }};
        const dasLabels = {{ dasLabels|default({})|json_encode|raw }};
        const groupementLabels = {{ groupementLabels|default({})|json_encode|raw }};
        
        // Store selected permissions from server
        let selectedPermissions = {{ (currentOrgPermissions|default([]))|json_encode|raw }};
        
        // CRITICAL: Initialize hidden input field with current permissions from DB
        if (orgPermissionsInput) {
            if (selectedPermissions && selectedPermissions.length > 0) {
                const jsonValue = JSON.stringify(selectedPermissions);
                orgPermissionsInput.value = jsonValue;
                orgPermissionsInput.setAttribute('value', jsonValue);
                console.log('✓ Initialized hidden input with', selectedPermissions.length, 'permissions from DB');
                console.log('Initial value:', jsonValue);
            } else {
                orgPermissionsInput.value = '[]';
                orgPermissionsInput.setAttribute('value', '[]');
                console.log('✓ Initialized hidden input with empty array (no permissions in DB)');
            }
            console.log('Input name:', orgPermissionsInput.name);
            console.log('Input id:', orgPermissionsInput.id);
            console.log('Input in form:', orgPermissionsInput.form ? 'YES' : 'NO');
        } else {
            console.error('✗✗✗ CRITICAL: Cannot initialize - input not found! ✗✗✗');
        }
        
        // Debug: log initial permissions
        console.log('Initial org permissions from server:', selectedPermissions);
        console.log('Hidden input initial value:', orgPermissionsInput ? orgPermissionsInput.value : 'N/A');
        console.log('Number of permissions:', selectedPermissions ? selectedPermissions.length : 0);
        
        // Store initial permissions for display (before modal is opened)
        const initialPermissions = selectedPermissions && selectedPermissions.length > 0 
            ? JSON.parse(JSON.stringify(selectedPermissions)) 
            : [];
        
        // Ensure we use initial permissions for display if selectedPermissions gets cleared
        const getDisplayPermissions = function() {
            // Always prefer initialPermissions if they exist (they represent what's saved in DB)
            if (initialPermissions && initialPermissions.length > 0) {
                console.log('getDisplayPermissions: Using initialPermissions (', initialPermissions.length, 'items):', initialPermissions);
                return initialPermissions;
            }
            // Fallback to selectedPermissions
            if (selectedPermissions && selectedPermissions.length > 0) {
                console.log('getDisplayPermissions: Using selectedPermissions (', selectedPermissions.length, 'items):', selectedPermissions);
                return selectedPermissions;
            }
            // No permissions at all
            console.log('getDisplayPermissions: No permissions found, returning empty array');
            return [];
        };
        
        // Initialize permissions from current data
        function initializeOrgPermissions() {
            console.log('=== initializeOrgPermissions() called ===');
            console.log('initialPermissions:', initialPermissions);
            console.log('selectedPermissions before restore:', selectedPermissions);
            
            // CRITICAL: Restore initial permissions from DB (they represent what's saved)
            if (initialPermissions && initialPermissions.length > 0) {
                selectedPermissions = JSON.parse(JSON.stringify(initialPermissions));
                console.log('✓ Restored selectedPermissions from initialPermissions:', selectedPermissions);
            } else {
                selectedPermissions = [];
                console.log('✓ No initial permissions, cleared selectedPermissions');
            }
            
            // CRITICAL: Update hidden input field with restored permissions
            if (orgPermissionsInput) {
                orgPermissionsInput.value = JSON.stringify(selectedPermissions);
                console.log('✓ Updated hidden input with restored permissions:', orgPermissionsInput.value);
            }
            
            // First, update display with initial permissions (before checking checkboxes)
            updateOrgPermissionsDisplay();
            
            // Then initialize checkboxes in modal (if modal is available)
            // Use a small delay to ensure modal DOM is ready
            setTimeout(function() {
                console.log('Initializing checkboxes in modal...');
                let checkboxesUpdated = 0;
                
                selectedPermissions.forEach(function(perm) {
                    const type = perm.type;
                    const groupement = perm.groupement;
                    const das = perm.das;
                    const dossier = perm.dossier;
                    
                    if (type === 'GROUPEMENT' && groupement) {
                        const checkbox = document.querySelector(`.org-groupement-checkbox[data-groupement="${groupement}"]`);
                        if (checkbox) {
                            checkbox.dataset.processing = 'true';
                            checkbox.checked = true;
                            checkboxesUpdated++;
                            // Also check all children
                            document.querySelectorAll(`.org-das-checkbox[data-groupement="${groupement}"], .org-dossier-checkbox[data-groupement="${groupement}"]`).forEach(function(cb) {
                                cb.checked = true;
                                checkboxesUpdated++;
                            });
                            delete checkbox.dataset.processing;
                        } else {
                            console.warn('Groupement checkbox not found for:', groupement);
                        }
                    } else if (type === 'DAS' && das && groupement) {
                        const checkbox = document.querySelector(`.org-das-checkbox[data-das="${das}"][data-groupement="${groupement}"]`);
                        if (checkbox) {
                            checkbox.dataset.processing = 'true';
                            checkbox.checked = true;
                            checkboxesUpdated++;
                            // Also check all dossiers in this DAS
                            document.querySelectorAll(`.org-dossier-checkbox[data-das="${das}"][data-groupement="${groupement}"]`).forEach(function(cb) {
                                cb.checked = true;
                                checkboxesUpdated++;
                            });
                            delete checkbox.dataset.processing;
                        } else {
                            console.warn('DAS checkbox not found for:', das, 'in', groupement);
                        }
                    } else if (type === 'DOSSIER' && dossier && das && groupement) {
                        const checkbox = document.querySelector(`.org-dossier-checkbox[data-dossier="${dossier}"][data-das="${das}"][data-groupement="${groupement}"]`);
                        if (checkbox) {
                            checkbox.checked = true;
                            checkboxesUpdated++;
                        } else {
                            console.warn('Dossier checkbox not found for:', dossier, 'in', das, groupement);
                        }
                    }
                });
                
                console.log('✓ Updated', checkboxesUpdated, 'checkboxes in modal');
                
                // Update parent checkboxes based on children
                updateParentCheckboxes();
                // Update permissions from checkboxes to ensure consistency
                updateOrgPermissionsFromCheckboxes();
            }, 100);
        }
        
        // Update permissions when checkboxes change - SIMPLIFIED VERSION
        function updateOrgPermissionsFromCheckboxes() {
            console.log('=== updateOrgPermissionsFromCheckboxes() called ===');
            
            // ALWAYS read from checkboxes in DOM (even if modal is closed, they might still be there)
            const checkedBoxes = document.querySelectorAll('.org-checkbox:checked');
            console.log('Found', checkedBoxes.length, 'checked checkboxes in DOM');
            
            // Reset selectedPermissions
            selectedPermissions = [];
            
            if (checkedBoxes.length > 0) {
                // Collect all checked permissions
                const allPerms = [];
                checkedBoxes.forEach(function(checkbox) {
                    let type = checkbox.getAttribute('data-type');
                    if (type) {
                        type = type.toUpperCase();
                    }
                    const groupement = checkbox.getAttribute('data-groupement');
                    const das = checkbox.getAttribute('data-das');
                    const dossier = checkbox.getAttribute('data-dossier');
                    
                    allPerms.push({
                        type: type || 'DOSSIER',
                        groupement: groupement || null,
                        das: das || null,
                        dossier: dossier || null
                    });
                });
                
                // Deduplicate: if groupement selected, don't include DAS/dossiers
                const selectedGroupements = new Set();
                const selectedDas = new Set();
                
                allPerms.forEach(function(perm) {
                    if (perm.type === 'GROUPEMENT' && perm.groupement) {
                        selectedGroupements.add(perm.groupement);
                    } else if (perm.type === 'DAS' && perm.das && perm.groupement) {
                        selectedDas.add(perm.groupement + '|' + perm.das);
                    }
                });
                
                allPerms.forEach(function(perm) {
                    if (perm.type === 'GROUPEMENT' && perm.groupement) {
                        selectedPermissions.push(perm);
                    } else if (perm.type === 'DAS' && perm.das && perm.groupement) {
                        if (!selectedGroupements.has(perm.groupement)) {
                            selectedPermissions.push(perm);
                        }
                    } else if (perm.type === 'DOSSIER' && perm.dossier && perm.das && perm.groupement) {
                        const dasKey = perm.groupement + '|' + perm.das;
                        if (!selectedGroupements.has(perm.groupement) && !selectedDas.has(dasKey)) {
                            selectedPermissions.push(perm);
                        }
                    }
                });
            }
            
            // ALWAYS update hidden input - this is CRITICAL
            if (orgPermissionsInput) {
                const jsonValue = JSON.stringify(selectedPermissions);
                orgPermissionsInput.value = jsonValue;
                
                // Also try to set it via setAttribute to be sure
                orgPermissionsInput.setAttribute('value', jsonValue);
                
                console.log('✓ Updated hidden input:', selectedPermissions.length, 'permissions');
                console.log('JSON value:', jsonValue);
                console.log('Input name:', orgPermissionsInput.name);
                console.log('Input id:', orgPermissionsInput.id);
                
                // Verify it was set
                if (orgPermissionsInput.value !== jsonValue) {
                    console.error('✗✗✗ WARNING: Value was not set correctly! ✗✗✗');
                    console.error('Expected:', jsonValue);
                    console.error('Got:', orgPermissionsInput.value);
                }
            } else {
                console.error('✗✗✗ CRITICAL: orgPermissionsInput NOT FOUND! ✗✗✗');
                // Try to find it again
                const foundInput = document.getElementById('organisation_permissions_input');
                if (foundInput) {
                    console.log('Found input on retry, updating...');
                    const jsonValue = JSON.stringify(selectedPermissions);
                    foundInput.value = jsonValue;
                    foundInput.setAttribute('value', jsonValue);
                } else {
                    console.error('Input still not found after retry!');
                }
            }
            
            updateOrgPermissionsDisplay();
        }
        
        // Update permissions display
        function updateOrgPermissionsDisplay() {
            // Double check element is valid and in DOM
            if (!selectedOrgPermissionsDisplay) {
                console.warn('selectedOrgPermissionsDisplay is null/undefined');
                return;
            }
            
            if (!(selectedOrgPermissionsDisplay instanceof Node)) {
                console.warn('selectedOrgPermissionsDisplay is not a Node instance');
                return;
            }
            
            if (!selectedOrgPermissionsDisplay.parentNode && !document.body.contains(selectedOrgPermissionsDisplay)) {
                console.warn('selectedOrgPermissionsDisplay is not in DOM');
                return;
            }
            
            // Use display permissions (initial if selectedPermissions is empty)
            const displayPermissions = getDisplayPermissions();
            console.log('updateOrgPermissionsDisplay - displayPermissions:', displayPermissions);
            console.log('updateOrgPermissionsDisplay - displayPermissions.length:', displayPermissions ? displayPermissions.length : 0);
            
            if (!displayPermissions || displayPermissions.length === 0) {
                try {
                    selectedOrgPermissionsDisplay.innerHTML = '<span class="no-modules-text">Aucune restriction (accès à toutes les organisations)</span>';
                } catch (e) {
                    console.error('Error setting innerHTML:', e);
                }
            } else {
                console.log('Processing', displayPermissions.length, 'permissions for display');
                const groupements = new Map();
                const dasMap = new Map();
                const dossiersSet = new Set();
                
                // Organize permissions by type
                displayPermissions.forEach(function(perm, index) {
                    console.log('Processing permission', index + ':', perm);
                    if (perm.type === 'GROUPEMENT' && perm.groupement) {
                        console.log('  -> Adding groupement:', perm.groupement);
                        groupements.set(perm.groupement, true);
                    } else if (perm.type === 'DAS' && perm.das && perm.groupement) {
                        const key = perm.groupement + '-' + perm.das;
                        console.log('  -> Adding DAS:', key);
                        if (!dasMap.has(key)) {
                            dasMap.set(key, {
                                groupement: perm.groupement,
                                das: perm.das
                            });
                        }
                    } else if (perm.type === 'DOSSIER' && perm.dossier && perm.das && perm.groupement) {
                        const key = perm.groupement + '-' + perm.das + '-' + perm.dossier;
                        console.log('  -> Adding dossier:', key);
                        dossiersSet.add(key);
                    } else {
                        console.log('  -> Permission skipped (missing required fields):', perm);
                    }
                });
                
                console.log('After processing:');
                console.log('  - groupements:', groupements.size, Array.from(groupements.keys()));
                console.log('  - dasMap:', dasMap.size);
                console.log('  - dossiersSet:', dossiersSet.size);
                
                // Build display HTML with badges
                let displayHTML = [];
                
                // Display groupements
                if (groupements.size > 0) {
                    console.log('Building groupement badges...');
                    groupements.forEach(function(hasAccess, groupement) {
                        const label = groupementLabels[groupement] || groupement;
                        const badge = '<span class="module-badge"><i class="fas fa-building"></i> ' + label + '</span>';
                        console.log('  -> Adding badge for groupement:', groupement, '->', label);
                        displayHTML.push(badge);
                    });
                } else {
                    console.log('No groupements to display');
                }
                
                // Display DAS (only if not already covered by groupement)
                if (dasMap.size > 0) {
                    dasMap.forEach(function(dasInfo, key) {
                        // Only show DAS if its groupement is not already shown
                        if (!groupements.has(dasInfo.groupement)) {
                            const dasLabel = dasLabels[dasInfo.das] || dasInfo.das;
                            displayHTML.push('<span class="module-badge"><i class="fas fa-layer-group"></i> ' + dasLabel + '</span>');
                        }
                    });
                }
                
                // Display dossiers count if any
                if (dossiersSet.size > 0) {
                    // Count unique dossiers
                    const uniqueDossiers = new Set();
                    dossiersSet.forEach(function(key) {
                        const parts = key.split('-');
                        if (parts.length >= 3) {
                            uniqueDossiers.add(parts[2]);
                        }
                    });
                    if (uniqueDossiers.size > 0) {
                        displayHTML.push('<span class="module-badge"><i class="fas fa-folder"></i> ' + uniqueDossiers.size + ' dossier(s)</span>');
                    }
                }
                
                console.log('Final displayHTML array length:', displayHTML.length);
                console.log('displayHTML content:', displayHTML);
                
                if (displayHTML.length > 0) {
                    console.log('Setting display with', displayHTML.length, 'badges');
                    try {
                        // Clear first, then set content to avoid MutationObserver issues
                        while (selectedOrgPermissionsDisplay.firstChild) {
                            selectedOrgPermissionsDisplay.removeChild(selectedOrgPermissionsDisplay.firstChild);
                        }
                        // Create a temporary div to parse HTML safely
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = displayHTML.join('');
                        // Append all children
                        while (tempDiv.firstChild) {
                            selectedOrgPermissionsDisplay.appendChild(tempDiv.firstChild);
                        }
                        console.log('✓ Successfully updated org permissions display with', displayHTML.length, 'badges');
                    } catch (e) {
                        console.error('✗ Error setting org permissions display:', e);
                        // Fallback to innerHTML
                        try {
                            selectedOrgPermissionsDisplay.innerHTML = displayHTML.join('');
                            console.log('✓ Fallback innerHTML succeeded');
                        } catch (e2) {
                            console.error('✗ Fallback also failed:', e2);
                        }
                    }
                } else {
                    console.log('No badges to display, showing "Aucune restriction"');
                    try {
                        selectedOrgPermissionsDisplay.textContent = '';
                        selectedOrgPermissionsDisplay.innerHTML = '<span class="no-modules-text">Aucune restriction (accès à toutes les organisations)</span>';
                    } catch (e) {
                        console.error('Error setting innerHTML (no restrictions):', e);
                    }
                }
            }
        }
        
        // Function to update parent checkboxes based on children
        function updateParentCheckboxes() {
            // Update all DAS checkboxes based on their dossiers
            document.querySelectorAll('.org-das-checkbox').forEach(function(dasCheckbox) {
                if (dasCheckbox.dataset.processing) return; // Skip if being processed
                
                const das = dasCheckbox.getAttribute('data-das');
                const groupement = dasCheckbox.getAttribute('data-groupement');
                const allDossiers = document.querySelectorAll(`.org-dossier-checkbox[data-das="${das}"][data-groupement="${groupement}"]`);
                const checkedDossiers = document.querySelectorAll(`.org-dossier-checkbox[data-das="${das}"][data-groupement="${groupement}"]:checked`);
                
                if (allDossiers.length > 0) {
                    dasCheckbox.dataset.processing = 'true';
                    dasCheckbox.checked = allDossiers.length === checkedDossiers.length;
                    delete dasCheckbox.dataset.processing;
                }
            });
            
            // Update all groupement checkboxes based on their DAS and dossiers
            document.querySelectorAll('.org-groupement-checkbox').forEach(function(groupementCheckbox) {
                if (groupementCheckbox.dataset.processing) return; // Skip if being processed
                
                const groupement = groupementCheckbox.getAttribute('data-groupement');
                
                // Check all dossiers in all DAS
                const allDossiersInGroupement = document.querySelectorAll(`.org-dossier-checkbox[data-groupement="${groupement}"]`);
                const checkedDossiersInGroupement = document.querySelectorAll(`.org-dossier-checkbox[data-groupement="${groupement}"]:checked`);
                
                if (allDossiersInGroupement.length > 0) {
                    groupementCheckbox.dataset.processing = 'true';
                    groupementCheckbox.checked = allDossiersInGroupement.length === checkedDossiersInGroupement.length;
                    delete groupementCheckbox.dataset.processing;
                } else {
                    // If no dossiers, check DAS level
                    const allDas = document.querySelectorAll(`.org-das-checkbox[data-groupement="${groupement}"]`);
                    const checkedDas = document.querySelectorAll(`.org-das-checkbox[data-groupement="${groupement}"]:checked`);
                    
                    if (allDas.length > 0) {
                        groupementCheckbox.dataset.processing = 'true';
                        groupementCheckbox.checked = allDas.length === checkedDas.length;
                        delete groupementCheckbox.dataset.processing;
                    }
                }
            });
        }
        
        // Handle groupement checkbox - select/deselect all DAS and dossiers
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('org-groupement-checkbox') && !e.target.dataset.processing) {
                e.target.dataset.processing = 'true';
                const groupement = e.target.getAttribute('data-groupement');
                const checked = e.target.checked;
                
                // Select/deselect all DAS in this groupement
                document.querySelectorAll(`.org-das-checkbox[data-groupement="${groupement}"]`).forEach(function(dasCheckbox) {
                    if (!dasCheckbox.dataset.processing) {
                        dasCheckbox.dataset.processing = 'true';
                        dasCheckbox.checked = checked;
                        // Also select/deselect all dossiers in each DAS
                        const das = dasCheckbox.getAttribute('data-das');
                        document.querySelectorAll(`.org-dossier-checkbox[data-das="${das}"][data-groupement="${groupement}"]`).forEach(function(dossierCheckbox) {
                            if (!dossierCheckbox.dataset.processing) {
                                dossierCheckbox.dataset.processing = 'true';
                                dossierCheckbox.checked = checked;
                                delete dossierCheckbox.dataset.processing;
                            }
                        });
                        delete dasCheckbox.dataset.processing;
                    }
                });
                
                // Also select/deselect any dossiers directly under groupement (if any)
                document.querySelectorAll(`.org-dossier-checkbox[data-groupement="${groupement}"]`).forEach(function(cb) {
                    if (!cb.dataset.processing) {
                        cb.checked = checked;
                    }
                });
                
                delete e.target.dataset.processing;
                setTimeout(function() {
                    updateOrgPermissionsFromCheckboxes();
                }, 50);
            }
        });
        
        // Handle DAS checkbox - select/deselect all dossiers in this DAS
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('org-das-checkbox') && !e.target.dataset.processing) {
                e.target.dataset.processing = 'true';
                const das = e.target.getAttribute('data-das');
                const groupement = e.target.getAttribute('data-groupement');
                const checked = e.target.checked;
                
                // Select/deselect all dossiers in this DAS
                document.querySelectorAll(`.org-dossier-checkbox[data-das="${das}"][data-groupement="${groupement}"]`).forEach(function(cb) {
                    if (!cb.dataset.processing) {
                        cb.dataset.processing = 'true';
                        cb.checked = checked;
                        // Trigger change event manually to ensure it's processed
                        cb.dispatchEvent(new Event('change', { bubbles: false }));
                        delete cb.dataset.processing;
                    }
                });
                
                delete e.target.dataset.processing;
                
                // Update parent groupement checkbox based on all DAS states
                setTimeout(function() {
                    updateParentCheckboxes();
                    updateOrgPermissionsFromCheckboxes();
                }, 50);
            }
        });
        
        // Handle dossier checkbox - update parent DAS and groupement
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('org-dossier-checkbox') && !e.target.dataset.processing) {
                // Update parent DAS and groupement checkboxes
                updateParentCheckboxes();
                updateOrgPermissionsFromCheckboxes();
            }
        });
        
        // Confirm organisation permissions selection
        confirmOrgPermissionsBtn.addEventListener('click', function() {
            console.log('=== CONFIRMING ORGANISATION PERMISSIONS SELECTION ===');
            
            // CRITICAL: Update permissions from checkboxes
            updateOrgPermissionsFromCheckboxes();
            
            // Verify and update display
            if (orgPermissionsInput) {
                console.log('Hidden input value:', orgPermissionsInput.value);
            }
            updateOrgPermissionsDisplay();
            
            // Close the modal
            let bootstrapModal;
            try {
                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    bootstrapModal = bootstrap.Modal.getInstance(orgPermissionsModal);
                }
                if (bootstrapModal) {
                    bootstrapModal.hide();
                } else {
                    // Fallback
                    orgPermissionsModal.classList.remove('show');
                    orgPermissionsModal.style.display = 'none';
                    document.body.classList.remove('modal-open');
                    const backdrop = document.querySelector('.modal-backdrop');
                    if (backdrop) backdrop.remove();
                }
            } catch (e) {
                console.error('Error closing org permissions modal:', e);
                // Fallback
                orgPermissionsModal.classList.remove('show');
                orgPermissionsModal.style.display = 'none';
                document.body.classList.remove('modal-open');
                const backdrop = document.querySelector('.modal-backdrop');
                if (backdrop) backdrop.remove();
            }
        });
        
        // Update display immediately on page load (before modal is opened)
        // This uses the initial permissions passed from the server
        // FORCE UPDATE IMMEDIATELY - This is critical for showing the summary
        console.log('=== INITIALIZING ORG PERMISSIONS DISPLAY ===');
        console.log('selectedPermissions:', selectedPermissions);
        console.log('initialPermissions:', initialPermissions);
        console.log('selectedOrgPermissionsDisplay element:', selectedOrgPermissionsDisplay);
        
        // Call updateOrgPermissionsDisplay immediately and multiple times to ensure it works
        function forceUpdateDisplay() {
            if (selectedOrgPermissionsDisplay) {
                console.log('Calling updateOrgPermissionsDisplay()...');
                try {
                    updateOrgPermissionsDisplay();
                    console.log('✓ Display update completed');
                } catch (e) {
                    console.error('✗ Error updating display:', e);
                    console.error('Stack:', e.stack);
                }
            } else {
                console.error('✗ selectedOrgPermissionsDisplay element is null!');
            }
        }
        
        // Call immediately
        forceUpdateDisplay();
        
        // Also call after DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                setTimeout(forceUpdateDisplay, 50);
            });
        } else {
            setTimeout(forceUpdateDisplay, 50);
        }
        
        // One more time after a longer delay to catch any edge cases
        setTimeout(forceUpdateDisplay, 300);
        
        // CRITICAL: Update hidden input before form submission
        const form = document.querySelector('.modern-form');
        if (form) {
            form.addEventListener('submit', function(e) {
                console.log('=== FORM SUBMISSION ===');
                
                // FORCE update from checkboxes
                updateOrgPermissionsFromCheckboxes();
                
                // Wait and verify
                setTimeout(function() {
                    if (!orgPermissionsInput) {
                        console.error('✗✗✗ CRITICAL: Input element not found!');
                        alert('ERREUR: Le champ de permissions est introuvable. Rechargez la page.');
                        e.preventDefault();
                        return false;
                    }
                    
                    const value = orgPermissionsInput.value;
                    const name = orgPermissionsInput.name;
                    
                    console.log('=== FINAL CHECK ===');
                    console.log('Input name:', name);
                    console.log('Input value:', value);
                    console.log('Input in form:', form.contains(orgPermissionsInput));
                    
                    if (!value || value === '[]' || value.trim() === '') {
                        console.error('✗✗✗ VALUE IS EMPTY! ✗✗✗');
                        // Try one more time
                        updateOrgPermissionsFromCheckboxes();
                        setTimeout(function() {
                            const newValue = orgPermissionsInput.value;
                            if (!newValue || newValue === '[]') {
                                console.error('✗✗✗ STILL EMPTY AFTER RETRY! ✗✗✗');
                                console.error('selectedPermissions:', selectedPermissions);
                                // Don't prevent - let it submit and check server logs
                            }
                        }, 50);
                    } else {
                        console.log('✓ Value is present, should save');
                    }
                }, 50);
            }, true); // Use capture phase
        } else {
            console.error('Form element not found!');
        }
        
        // CRITICAL: Initialize checkboxes when modal is opened
        if (orgPermissionsModal) {
            orgPermissionsModal.addEventListener('show.bs.modal', function() {
                console.log('=== ORG PERMISSIONS MODAL OPENED ===');
                console.log('Initializing checkboxes with permissions:', initialPermissions);
                // Restore permissions from DB
                if (initialPermissions && initialPermissions.length > 0) {
                    selectedPermissions = JSON.parse(JSON.stringify(initialPermissions));
                    // Update hidden input
                    if (orgPermissionsInput) {
                        orgPermissionsInput.value = JSON.stringify(selectedPermissions);
                    }
                }
                // Initialize checkboxes
                setTimeout(function() {
                    initializeOrgPermissions();
                }, 50);
            });
            
            orgPermissionsModal.addEventListener('shown.bs.modal', function() {
                console.log('=== ORG PERMISSIONS MODAL FULLY SHOWN ===');
                // One more time after modal is fully shown
                setTimeout(function() {
                    initializeOrgPermissions();
                }, 100);
            });
        }
        
        // Initialize permissions on page load (for modal checkboxes)
        initializeOrgPermissions();
    }
});
</script>

