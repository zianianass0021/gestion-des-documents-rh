            font-size: 0.95rem;
        }


        .features-section {
            padding: 2rem 0;
        }

        .features-header {
            margin-bottom: 1.25rem;
        }

        .features-title {
            font-size: 1.5rem;
        }

        .features-subtitle {
            font-size: 0.85rem;
        }

        .features-grid {
            gap: 0.75rem;
        }

        .feature-card {
            padding: 1rem;
        }

        .feature-icon {
            margin-bottom: 0.5rem;
        }
        
        .feature-icon i {
