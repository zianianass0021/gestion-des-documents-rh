# Symfony Environment
APP_ENV=prod
APP_SECRET=!ChangeMe!
APP_DEBUG=0

# PostgreSQL Configuration
POSTGRES_VERSION=16
POSTGRES_DB=rh_docs
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!
POSTGRES_PORT=5432

# ClickHouse Configuration
CLICKHOUSE_VERSION=latest
CLICKHOUSE_DATABASE=rh_olap
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Symfony Port
SYMFONY_PORT=8000

# Database URL (automatically constructed from above, but can override)
# DATABASE_URL=postgresql://app:!ChangeMe!@database:5432/rh_docs?serverVersion=16&charset=utf8

# ClickHouse HTTP URL (automatically constructed from above, but can override)
# CLICKHOUSE_HTTP_URL=http://clickhouse:8123

